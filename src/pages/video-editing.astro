---
/**
 * video-editing.astro - Página de Edición de Videos
 *
 * Estructura semántica completa:
 * - Hero con video de fondo y CTA
 * - Galería de trabajos destacados
 * - Cards de precios con 3 planes
 * - FAQ con acordeón interactivo
 * - CTA final de conversión
 *
 * Accesibilidad: landmarks ARIA, skip links, reduced-motion,
 * contraste 4.5:1, foco visible, alt text descriptivos.
 */
import BaseLayout from "../layouts/BaseLayout.astro";

/** Datos de la galería */
const gallery = [
  {
    title: "Lumina Motors",
    category: "Comercial Automotriz",
    image: "https://images.unsplash.com/photo-1574717024653-61fd2cf4d44d?w=800&h=600&fit=crop&q=80",
    alt: "Comercial de lujo para Lumina Motors con efectos de luz neón y movimiento cinematográfico"
  },
  {
    title: "Neon Nights",
    category: "After Effects",
    image: "https://images.unsplash.com/photo-1551288049-bebda4e38f71?w=800&h=600&fit=crop&q=80",
    alt: "Secuencia de motion graphics con estética neón para marca nocturna"
  },
  {
    title: "Aura Tech",
    category: "VFX Compositing",
    image: "https://images.unsplash.com/photo-1492691527719-9d1e07e534b4?w=800&h=600&fit=crop&q=80",
    alt: "Composición visual con elementos 3D integrados para tecnología Aura"
  },
  {
    title: "SportFlow",
    category: "Deportes",
    image: "https://images.unsplash.com/photo-1579165466809-0685c4ae12f7?w=800&h=600&fit=crop&q=80",
    alt: "Edición dinámica de deportes con transiciones rápidas y slow motion"
  },
  {
    title: "Culinary Arts",
    category: "Gastronomía",
    image: "https://images.unsplash.com/photo-1556910103-1c02745aae4d?w=800&h=600&fit=crop&q=80",
    alt: "Video gastronómico con iluminación profesional y detail shots"
  },
  {
    title: "Urban Pulse",
    category: "Documental",
    image: "https://images.unsplash.com/photo-1514525253161-7a46d19cd819?w=800&h=600&fit=crop&q=80",
    alt: "Documental urbano con estilo visual crudo y narrativa envolvente"
  }
];

/** Planes de precios */
const plans = [
  {
    name: "Básico",
    price: "$1,500",
    period: "por proyecto",
    description: "Ideal para contenido de redes sociales y videos cortos.",
    features: [
      "Video de hasta 60 segundos",
      "Edición básica con transiciones",
      "Color grading estándar",
      "Música de stock incluida",
      "2 rondas de revisión",
      "Entrega en 5 días"
    ],
    cta: "Elegir Básico",
    popular: false,
    icon: "videocam"
  },
  {
    name: "Profesional",
    price: "$4,500",
    period: "por proyecto",
    description: "Para marcas que necesitan contenido cinematográfico.",
    features: [
      "Video de hasta 3 minutos",
      "Motion graphics personalizados",
      "Color grading profesional",
      "Sonido diseño y mezcla",
      "VFX compositing básico",
      "5 rondas de revisión",
      "Entrega en 10 días"
    ],
    cta: "Elegir Profesional",
    popular: true,
    icon: "movie"
  },
  {
    name: "Premium",
    price: "$12,000",
    period: "por proyecto",
    description: "Producción completa con efectos visuales de alto nivel.",
    features: [
      "Video ilimitado en duración",
      "VFX avanzados y 3D",
      "Motion graphics complejos",
      "Color grading cinematográfico",
      "Diseño de sonido completo",
      "Edición ilimitada",
      "Entrega prioritaria",
      "Soporte post-entrega 30 días"
    ],
    cta: "Elegir Premium",
    popular: false,
    icon: "auto_awesome"
  }
];

/** FAQ */
const faq = [
  {
    question: "¿Qué software de edición utilizan?",
    answer: "Utilizamos Adobe Premiere Pro, After Effects, DaVinci Resolve y Final Cut Pro. Para efectos visuales avanzados, trabajamos con Nuke y Houdini."
  },
  {
    question: "¿Cuánto tiempo tarda la entrega de un proyecto?",
    answer: "Depende de la complejidad. Un video de redes sociales puede estar listo en 3-5 días. Producciones más complejas pueden tomar 2-4 semanas."
  },
  {
    question: "¿Pueden trabajar con nuestro propio footage?",
    answer: "Sí, aceptamos material filmado por el cliente. También ofrecemos servicios de grabación profesional si necesitas producción completa."
  },
  {
    question: "¿Incluyen música y efectos de sonido?",
    answer: "Sí, todos nuestros paquetes incluyen música de licencia libre o bibliotecas premium. Para música original, ofrecemos servicios adicionales."
  },
  {
    question: "¿Ofrecen paquetes de mantenimiento mensual?",
    answer: "Sí, ofrecemos suscripciones mensuales para marcas que necesitan contenido regular. Incluye descuentos significativos por volumen."
  }
];
---

<BaseLayout
  title="Edición de Videos - Daller"
  description="Servicio profesional de edición de video con efectos visuales cinematográficos. Motion graphics, VFX, color grading y más."
>
  <main>
    <!-- ═══════════════════════════════════════════════ -->
    <!-- HERO SECTION -->
    <!-- ═══════════════════════════════════════════════ -->
    <section
      class="relative min-h-dvh flex items-center justify-center overflow-hidden"
      aria-labelledby="video-hero-heading"
    >
      <!-- Fondo con imagen y overlay -->
      <div class="absolute inset-0 z-0">
        <img
          src="https://images.unsplash.com/photo-1574717024653-61fd2cf4d44d?w=1920&h=1080&fit=crop&q=80"
          alt=""
          class="w-full h-full object-cover hero-bg-image"
          aria-hidden="true"
        />
        <div class="absolute inset-0 bg-gradient-to-b from-surface/60 via-surface/40 to-surface/95"></div>
        <div class="absolute inset-0 bg-gradient-to-t from-surface via-transparent to-transparent"></div>
      </div>

      <!-- Contenido del hero -->
      <div class="relative z-10 max-w-[1200px] mx-auto w-full text-center px-6 md:px-12 hero-content">
        <div class="inline-flex items-center gap-2 bg-[#32D74B]/10 border border-[#32D74B]/30 rounded-full px-5 py-2 mb-8">
          <span class="material-symbols-outlined text-[#32D74B] text-lg" style="font-variation-settings: 'FILL' 0;">videocam</span>
          <span class="label-md text-sm text-[#32D74B] uppercase tracking-wider">Motion VFX</span>
        </div>

        <h1
          id="video-hero-heading"
          class="heading-xl text-5xl sm:text-6xl md:text-7xl lg:text-8xl text-white max-w-5xl mx-auto mb-6"
          style="text-shadow: 0 4px 40px rgba(0,0,0,0.8);"
        >
          Edición de <span class="text-[#32D74B]">Videos</span>
        </h1>

        <p
          class="body-lg text-xl md:text-2xl text-white/90 max-w-2xl mx-auto mb-10"
          style="text-shadow: 0 2px 20px rgba(0,0,0,0.9);"
        >
          Transformamos footage crudo en narrativas cinematográficas que cautivan. Efectos visuales de alto impacto.
        </p>

        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a class="btn-primary text-lg px-10 py-5" href="/contact">
            Iniciar Proyecto
            <span class="material-symbols-outlined" style="font-variation-settings: 'FILL' 0;">arrow_forward</span>
          </a>
          <a
            class="inline-flex items-center justify-center gap-3 px-10 py-5 rounded-full border-2 border-white/30 text-white font-semibold hover:bg-white/10 transition-all duration-300"
            href="#gallery"
          >
            <span class="material-symbols-outlined" style="font-variation-settings: 'FILL' 0;">play_circle</span>
            Ver Portfolio
          </a>
        </div>
      </div>

      <!-- Indicador de scroll -->
      <div class="absolute bottom-8 left-1/2 -translate-x-1/2 z-10 flex flex-col items-center gap-2 opacity-70" aria-hidden="true">
        <span class="label-md text-xs text-white/60 uppercase tracking-widest">Scroll</span>
        <div class="w-6 h-10 rounded-full border-2 border-white/30 flex justify-center pt-2">
          <div class="w-1 h-3 bg-white/60 rounded-full animate-bounce"></div>
        </div>
      </div>
    </section>

    <!-- ═══════════════════════════════════════════════ -->
    <!-- GALERÍA SECTION -->
    <!-- ═══════════════════════════════════════════════ -->
    <section
      id="gallery"
      class="py-24 md:py-32 px-6 md:px-12 bg-surface"
      aria-labelledby="gallery-heading"
    >
      <div class="max-w-[1440px] mx-auto w-full">
        <header class="text-center mb-16 md:mb-20">
          <span class="label-md text-sm text-[#32D74B] uppercase tracking-widest mb-4 block">Portfolio</span>
          <h2 id="gallery-heading" class="heading-lg text-3xl md:text-4xl lg:text-5xl text-text-primary mb-6">
            Proyectos Destacados
          </h2>
          <p class="body-lg text-lg text-text-muted max-w-2xl mx-auto">
            Una selección de nuestros trabajos más impactantes en edición de video y efectos visuales.
          </p>
        </header>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 md:gap-8">
          {gallery.map((item, index) => (
            <article
              class="group relative rounded-3xl overflow-hidden glass-panel hover-lift-card cursor-pointer gallery-item"
              style={`animation-delay: ${index * 100}ms`}
            >
              <div class="aspect-[4/3] relative overflow-hidden">
                <img
                  src={item.image}
                  alt={item.alt}
                  class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
                  loading="lazy"
                  width="800"
                  height="600"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-surface/90 via-surface/20 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>

                <!-- Overlay con info -->
                <div class="absolute inset-0 flex flex-col justify-end p-6 opacity-0 group-hover:opacity-100 transition-opacity duration-300">
                  <span class="label-md text-xs text-[#32D74B] uppercase tracking-widest mb-2">{item.category}</span>
                  <h3 class="heading-md text-xl text-white">{item.title}</h3>
                </div>

                <!-- Icono de play -->
                <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-16 h-16 rounded-full bg-[#32D74B] flex items-center justify-center opacity-0 group-hover:opacity-100 transition-all duration-300 transform scale-75 group-hover:scale-100 shadow-[0_0_30px_rgba(50,215,75,0.5)]">
                  <span class="material-symbols-outlined text-3xl text-surface-container-lowest" style="font-variation-settings: 'FILL' 1;">play_arrow</span>
                </div>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- ═══════════════════════════════════════════════ -->
    <!-- PRECIOS SECTION -->
    <!-- ═══════════════════════════════════════════════ -->
    <section
      class="py-24 md:py-32 px-6 md:px-12 bg-surface-container-lowest"
      aria-labelledby="pricing-heading"
    >
      <div class="max-w-[1440px] mx-auto w-full">
        <header class="text-center mb-16 md:mb-20">
          <span class="label-md text-sm text-[#32D74B] uppercase tracking-widest mb-4 block">Precios</span>
          <h2 id="pricing-heading" class="heading-lg text-3xl md:text-4xl lg:text-5xl text-text-primary mb-6">
            Planes de Edición
          </h2>
          <p class="body-lg text-lg text-text-muted max-w-2xl mx-auto">
            Elige el plan que mejor se adapte a las necesidades de tu proyecto.
          </p>
        </header>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-8 max-w-5xl mx-auto">
          {plans.map((plan) => (
            <article
              class={`relative glass-panel p-8 rounded-3xl border ${
                plan.popular
                  ? 'border-[#B535F6]/50 shadow-[0_0_40px_rgba(181,53,246,0.15)]'
                  : 'border-outline-variant/20'
              } hover-lift-card pricing-card`}
              aria-labelledby={`plan-${plan.name}`}
            >
              {plan.popular && (
                <div class="absolute -top-4 left-1/2 -translate-x-1/2">
                  <span class="bg-[#B535F6] text-white px-5 py-2 rounded-full label-md text-xs uppercase tracking-wider">
                    Más Popular
                  </span>
                </div>
              )}

              <div class="text-center mb-8">
                <div class="w-14 h-14 rounded-full bg-[#32D74B]/10 flex items-center justify-center mx-auto mb-4">
                  <span class="material-symbols-outlined text-2xl text-[#32D74B]" style="font-variation-settings: 'FILL' 0;">{plan.icon}</span>
                </div>
                <h3 id={`plan-${plan.name}`} class="heading-md text-2xl text-text-primary mb-2">{plan.name}</h3>
                <div class="mb-3">
                  <span class={`heading-xl text-4xl ${plan.popular ? 'text-[#B535F6]' : 'text-[#32D74B]'}`}>{plan.price}</span>
                  <span class="body-md text-text-muted ml-2 text-sm">{plan.period}</span>
                </div>
                <p class="body-md text-text-muted text-sm">{plan.description}</p>
              </div>

              <ul class="space-y-3 mb-8" role="list">
                {plan.features.map((feature) => (
                  <li class="flex items-start gap-3 text-text-primary body-md text-sm">
                    <span class="material-symbols-outlined text-[#32D74B] text-lg mt-0.5 flex-shrink-0" style="font-variation-settings: 'FILL' 1;">check_circle</span>
                    <span>{feature}</span>
                  </li>
                ))}
              </ul>

              <a
                class={`w-full inline-flex items-center justify-center gap-2 px-8 py-4 rounded-full font-semibold transition-all duration-300 ${
                  plan.popular
                    ? 'bg-[#B535F6] text-white hover:scale-[1.02] shadow-[0_4px_20px_rgba(181,53,246,0.4)]'
                    : 'border-2 border-[#32D74B] text-[#32D74B] hover:bg-[#32D74B] hover:text-surface-container-lowest'
                }`}
                href="/contact"
                aria-label={`${plan.cta} - plan ${plan.name}`}
              >
                {plan.cta}
                <span class="material-symbols-outlined" style="font-variation-settings: 'FILL' 0;">arrow_forward</span>
              </a>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- ═══════════════════════════════════════════════ -->
    <!-- FAQ SECTION -->
    <!-- ═══════════════════════════════════════════════ -->
    <section
      class="py-24 md:py-32 px-6 md:px-12"
      aria-labelledby="faq-heading"
    >
      <div class="max-w-[800px] mx-auto w-full">
        <header class="text-center mb-16">
          <span class="label-md text-sm text-[#32D74B] uppercase tracking-widest mb-4 block">FAQ</span>
          <h2 id="faq-heading" class="heading-lg text-3xl md:text-4xl text-text-primary mb-6">
            Preguntas Frecuentes
          </h2>
        </header>

        <div class="space-y-4" role="list">
          {faq.map((item, index) => (
            <div
              class="glass-panel rounded-2xl border border-outline-variant/20 overflow-hidden faq-item"
              role="listitem"
            >
              <button
                class="w-full px-6 py-5 text-left flex justify-between items-center gap-4 hover:bg-surface-container-high/30 transition-colors"
                aria-expanded="false"
                aria-controls={`faq-answer-${index}`}
              >
                <span class="heading-md text-base md:text-lg text-text-primary">{item.question}</span>
                <span class="material-symbols-outlined text-[#32D74B] transform transition-transform duration-300 flex-shrink-0">
                  expand_more
                </span>
              </button>
              <div
                id={`faq-answer-${index}`}
                class="faq-answer hidden px-6 pb-6"
                role="region"
              >
                <p class="body-md text-text-muted leading-relaxed">{item.answer}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ═══════════════════════════════════════════════ -->
    <!-- CTA SECTION -->
    <!-- ═══════════════════════════════════════════════ -->
    <section
      class="py-24 md:py-32 px-6 md:px-12 bg-surface-container-lowest"
      aria-labelledby="cta-heading"
    >
      <div class="max-w-[1000px] mx-auto w-full text-center">
        <h2 id="cta-heading" class="heading-lg text-3xl md:text-4xl lg:text-5xl text-text-primary mb-6">
          ¿Listo para elevar tu contenido?
        </h2>
        <p class="body-lg text-lg text-text-muted max-w-2xl mx-auto mb-10">
          Nuestro equipo de editores profesionales está listo para transformar tu visión en una realidad cinematográfica.
        </p>
        <a class="btn-primary text-lg px-10 py-5" href="/contact">
          Solicitar Presupuesto Gratuito
          <span class="material-symbols-outlined" style="font-variation-settings: 'FILL' 0;">arrow_forward</span>
        </a>
      </div>
    </section>
  </main>
</BaseLayout>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  function initVideoPage() {
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (prefersReducedMotion) return;

    // Hero animations
    const heroContent = document.querySelector('.hero-content');
    const heroBg = document.querySelector('.hero-bg-image');

    if (heroContent) {
      const tl = gsap.timeline({ delay: 0.2 });
      tl.from(heroContent.querySelector('h1'), { y: 60, opacity: 0, duration: 1, ease: "power3.out" })
        .from(heroContent.querySelector('p'), { y: 40, opacity: 0, duration: 0.8, ease: "power3.out" }, "-=0.6")
        .from(heroContent.querySelectorAll('.btn-primary, a[href="#gallery"]'), { y: 30, opacity: 0, scale: 0.9, duration: 0.6, ease: "back.out(1.7)", stagger: 0.15 }, "-=0.4");
    }

    if (heroBg) {
      gsap.to(heroBg, {
        y: 200,
        scale: 1.1,
        ease: "none",
        scrollTrigger: { trigger: heroBg.closest('section'), start: "top top", end: "bottom top", scrub: true }
      });
    }

    // Gallery stagger
    gsap.from('.gallery-item', {
      y: 60,
      opacity: 0,
      duration: 0.8,
      stagger: 0.12,
      ease: "power3.out",
      scrollTrigger: { trigger: '#gallery', start: "top 80%", toggleActions: "play none none none" }
    });

    // Pricing cards
    gsap.from('.pricing-card', {
      y: 80,
      opacity: 0,
      duration: 0.8,
      stagger: 0.15,
      ease: "power3.out",
      scrollTrigger: { trigger: '[aria-labelledby="pricing-heading"]', start: "top 80%", toggleActions: "play none none none" }
    });

    // FAQ
    document.querySelectorAll('.faq-item button').forEach((button) => {
      button.addEventListener('click', () => {
        const isExpanded = button.getAttribute('aria-expanded') === 'true';
        const answer = button.nextElementSibling;
        const icon = button.querySelector('.material-symbols-outlined');

        // Close others
        document.querySelectorAll('.faq-item button').forEach((btn) => {
          if (btn !== button) {
            btn.setAttribute('aria-expanded', 'false');
            btn.nextElementSibling?.classList.add('hidden');
            btn.querySelector('.material-symbols-outlined')?.classList.remove('rotate-180');
          }
        });

        button.setAttribute('aria-expanded', (!isExpanded).toString());
        answer?.classList.toggle('hidden');
        icon?.classList.toggle('rotate-180');
      });
    });
  }

  document.addEventListener('astro:page-load', initVideoPage);
  initVideoPage();
</script>

<style>
  .faq-answer { transition: all 0.3s ease; }
  .faq-item button:focus-visible { outline: 2px solid var(--color-primary); outline-offset: -2px; border-radius: 12px; }
</style>