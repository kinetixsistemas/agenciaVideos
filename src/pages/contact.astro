---
/**
 * contact.astro - Página de contacto
 *
 * Layout de dos columnas:
 * - Izquierda: Título, descripción, información de contacto
 * - Derecha: Formulario en glass-panel con:
 *   - Campos: nombre, email, empresa
 *   - Slider de presupuesto (range input)
 *   - Textarea de detalles del proyecto
 *   - Estado de éxito overlay
 *
 * Incluye JavaScript para:
 * - Actualización del display del presupuesto
 * - Manejo del envío del formulario
 * - Reset del formulario
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import { siteConfig } from "../data/site";
---

<BaseLayout
  title="Contacto - Electric Apple"
  description="Construyamos algo icónico. ¿Listo para superar límites? Nos asociamos con marcas visionarias para engineerar experiencias digitales que exigen atención."
>
  <!-- Contenido principal -->
  <main class="flex-grow pt-32 pb-[var(--section-gap)] px-[var(--page-margin-mobile)] md:px-[var(--page-margin-desktop)] max-w-[1440px] mx-auto w-full">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-[var(--gutter)] mt-16 md:mt-32">
      <!-- Columna izquierda: Contexto -->
      <div class="flex flex-col gap-12 pr-0 md:pr-16">
        <div>
          <h1 class="font-headline-lg-mobile text-headline-lg-mobile md:font-headline-lg md:text-headline-lg text-text-primary mb-6">Construyamos algo icónico.</h1>
          <p class="font-body-lg text-body-lg text-on-surface-variant max-w-md">¿Listo para superar límites? Nos asociamos con marcas visionarias para engineerar experiencias digitales que exigen atención.</p>
        </div>
        <div class="flex flex-col gap-8">
          <!-- Dirección -->
          <div>
            <h3 class="font-label-md text-label-md text-text-muted mb-2 uppercase tracking-widest">Sede Global</h3>
            <p class="font-body-md text-body-md text-on-surface">
              1200 Neon Ave, Suite 404<br />Distrito Neo-Tokyo, CA 90210
            </p>
          </div>
          <!-- Email -->
          <div>
            <h3 class="font-label-md text-label-md text-text-muted mb-2 uppercase tracking-widest">Línea Directa</h3>
            <a
              class="font-body-md text-body-md text-primary hover:text-primary-fixed transition-colors inline-flex items-center gap-2"
              href={`mailto:${siteConfig.email}`}
            >
              {siteConfig.email}
              <span class="material-symbols-outlined text-sm" style="font-variation-settings: 'FILL' 0;">arrow_outward</span>
            </a>
          </div>
        </div>
      </div>

      <!-- Columna derecha: Formulario -->
      <div class="glass-panel rounded-[32px] p-8 md:p-12 relative overflow-hidden group">
        <form class="flex flex-col gap-10 relative z-10" id="contact-form" aria-label="Formulario de contacto">
          <!-- Campos de nombre y email -->
          <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
            <div class="flex flex-col gap-2">
              <label class="font-label-md text-label-md text-text-muted" for="name">Nombre</label>
              <input
                class="bg-transparent border-0 border-b-2 border-surface-container-high px-0 py-3 font-body-lg text-body-lg text-text-primary neon-input transition-colors focus:ring-0"
                type="text"
                id="name"
                name="name"
                required
                autocomplete="name"
              />
            </div>
            <div class="flex flex-col gap-2">
              <label class="font-label-md text-label-md text-text-muted" for="email">Email</label>
              <input
                class="bg-transparent border-0 border-b-2 border-surface-container-high px-0 py-3 font-body-lg text-body-lg text-text-primary neon-input transition-colors focus:ring-0"
                type="email"
                id="email"
                name="email"
                required
                autocomplete="email"
              />
            </div>
          </div>
          <!-- Campo de empresa -->
          <div class="flex flex-col gap-2">
            <label class="font-label-md text-label-md text-text-muted" for="company">Empresa (Opcional)</label>
            <input
              class="bg-transparent border-0 border-b-2 border-surface-container-high px-0 py-3 font-body-lg text-body-lg text-text-primary neon-input transition-colors focus:ring-0"
              type="text"
              id="company"
              name="company"
              autocomplete="organization"
            />
          </div>
          <!-- Slider de presupuesto -->
          <div class="flex flex-col gap-6">
            <div class="flex justify-between items-end">
              <label class="font-label-md text-label-md text-text-muted" for="budget">Presupuesto Estimado</label>
              <span class="font-headline-md text-headline-md text-primary" id="budget-display">$50k+</span>
            </div>
            <input
              class="w-full h-1 bg-surface-container-high rounded-lg appearance-none cursor-pointer custom-slider"
              type="range"
              id="budget"
              name="budget"
              min="10"
              max="200"
              value="50"
              step="10"
            />
          </div>
          <!-- Campo de detalles -->
          <div class="flex flex-col gap-2">
            <label class="font-label-md text-label-md text-text-muted" for="details">Detalles del Proyecto</label>
            <textarea
              class="bg-transparent border-0 border-b-2 border-surface-container-high px-0 py-3 font-body-lg text-body-lg text-text-primary neon-input transition-colors focus:ring-0 resize-none placeholder-surface-container-highest"
              id="details"
              name="details"
              rows="3"
              placeholder="Cuéntanos sobre tu visión..."
            ></textarea>
          </div>
          <!-- Botón de envío -->
          <button
            type="submit"
            class="w-full bg-[#32D74B] text-black font-button text-button py-5 rounded-full hover:scale-[1.02] transition-transform duration-300 mt-4 shadow-[0_0_20px_rgba(50,215,75,0.3)] hover:shadow-[0_0_30px_rgba(50,215,75,0.5)]"
          >
            ENVIAR TRANSMISIÓN
          </button>
        </form>

        <!-- Estado de éxito (oculto por defecto) -->
        <div class="absolute inset-0 flex flex-col items-center justify-center p-12 text-center bg-surface-container/95 backdrop-blur-md hidden z-20 transition-all duration-500 rounded-[32px]" id="form-success">
          <div class="w-24 h-24 rounded-full bg-[#B535F6]/20 flex items-center justify-center mb-6 shadow-[0_0_40px_rgba(181,53,246,0.4)]">
            <span class="material-symbols-outlined text-5xl text-[#B535F6]" style="font-variation-settings: 'FILL' 1;">done_all</span>
          </div>
          <h3 class="font-headline-md text-headline-md text-text-primary mb-4">Transmisión Recibida</h3>
          <p class="font-body-md text-body-md text-on-surface-variant max-w-sm">Hemos interceptado tu señal. Nuestro equipo revisará la información y se pondrá en contacto contigo pronto.</p>
          <button
            class="mt-8 font-button text-button text-primary hover:text-primary-fixed border-b border-primary/30 pb-1 hover:border-primary transition-colors"
            id="send-another"
          >
            Enviar otra
          </button>
        </div>
      </div>
    </div>
  </main>
</BaseLayout>

<style>
  /* Estilos personalizados para el slider de presupuesto */
  .custom-slider::-webkit-slider-thumb {
    -webkit-appearance: none;
    appearance: none;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: #B535F6;
    cursor: pointer;
    box-shadow: 0 0 10px rgba(181, 53, 246, 0.5);
  }
  .custom-slider::-moz-range-thumb {
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: #B535F6;
    cursor: pointer;
    box-shadow: 0 0 10px rgba(181, 53, 246, 0.5);
  }
</style>

<script>
  /**
   * Inicializa el formulario de contacto con:
   * - Actualización en tiempo real del display de presupuesto
   * - Manejo del envío (prevenir default, mostrar éxito)
   * - Botón "Enviar otra" para resetear el formulario
   */
  function initContactForm() {
    const form = document.getElementById("contact-form") as HTMLFormElement;
    const success = document.getElementById("form-success");
    const sendAnother = document.getElementById("send-another");
    const budgetSlider = document.getElementById("budget") as HTMLInputElement;
    const budgetDisplay = document.getElementById("budget-display");

    // Actualizar display del presupuesto al mover el slider
    if (budgetSlider && budgetDisplay) {
      budgetSlider.addEventListener("input", () => {
        budgetDisplay.innerText = `$${budgetSlider.value}k+`;
      });
    }

    if (!form || !success || !sendAnother) return;

    // Manejar envío del formulario
    form.addEventListener("submit", (e) => {
      e.preventDefault();
      form.classList.add("opacity-0", "pointer-events-none");
      success.classList.remove("hidden");
    });

    // Resetear formulario
    sendAnother.addEventListener("click", () => {
      form.reset();
      form.classList.remove("opacity-0", "pointer-events-none");
      success.classList.add("hidden");
      if (budgetDisplay) budgetDisplay.innerText = "$50k+";
    });
  }

  // Inicializar en carga de página y en transiciones de Astro
  document.addEventListener("astro:page-load", initContactForm);
  initContactForm();
</script>
