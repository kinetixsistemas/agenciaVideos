---
/**
 * 404.astro - Página de error "No encontrado"
 *
 * Muestra un mensaje amigable cuando el usuario
 * intenta acceder a una ruta que no existe.
 * Incluye enlace para volver al inicio.
 */
import BaseLayout from "../layouts/BaseLayout.astro";
---

<!-- Página de error 404 centrada verticalmente -->
<BaseLayout title="Sección No Encontrada - Electric Apple">
  <section class="min-h-[70vh] flex items-center justify-center text-center px-4">
    <div>
      <!-- Número de error grande y decorativo -->
      <h1 class="text-7xl md:text-9xl font-extrabold text-primary mb-4" aria-hidden="true">
        404
      </h1>
      <!-- Título del error -->
      <h2 class="text-2xl md:text-3xl font-bold mb-4">
        Señal Perdida
      </h2>
      <!-- Descripción del error -->
      <p class="text-text-muted text-lg mb-8 max-w-md mx-auto">
        La página que buscas no existe o ha sido trasladada a otra dimensión.
      </p>
      <!-- Botón para volver al inicio -->
      <a
        class="inline-flex items-center justify-center rounded-full h-14 px-10 bg-[#32D74B] text-surface-container-lowest text-base font-bold hover:scale-105 transition-all duration-300"
        href="/"
      >
        Volver al Inicio
      </a>
    </div>
  </section>
</BaseLayout>
