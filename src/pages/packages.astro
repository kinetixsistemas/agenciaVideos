---
/**
 * packages.astro - Página de Paquetes y Planes
 *
 * Muestra los diferentes paquetes de servicios con:
 * - Paquete Básico
 * - Paquete Profesional
 * - Paquete Enterprise
 * - Comparativa de características
 * - CTA final
 */
import BaseLayout from "../layouts/BaseLayout.astro";

/** Paquetes disponibles */
const packages = [
  {
    name: "Básico",
    price: "$2,500",
    period: "por proyecto",
    description: "Ideal para emprendedores y pequeñas empresas que necesitan presencia digital inicial.",
    features: [
      "Landing Page Responsive",
      "Diseño UI/UX Personalizado",
      "Optimización SEO Básica",
      "Formulario de Contacto",
      "Integración con Redes Sociales",
      "Soporte por 30 días"
    ],
    cta: "Elegir Básico",
    popular: false,
    color: "#32D74B"
  },
  {
    name: "Profesional",
    price: "$7,500",
    period: "por proyecto",
    description: "Para empresas en crecimiento que buscan una presencia digital completa y profesional.",
    features: [
      "Hasta 5 Páginas Web",
      "Diseño UI/UX Avanzado",
      "Optimización SEO Completa",
      "Blog Integrado",
      "Sistema de Gestión de Contenido",
      "Animaciones GSAP Premium",
      "Soporte por 90 días",
      "Mantenimiento mensual opcional"
    ],
    cta: "Elegir Profesional",
    popular: true,
    color: "#B535F6"
  },
  {
    name: "Enterprise",
    price: "Personalizado",
    period: "presupuesto a medida",
    description: "Soluciones a medida para empresas que necesitan escalabilidad y funcionalidades avanzadas.",
    features: [
      "Sitio Web Ilimitado",
      "Diseño UI/UX Personalizado",
      "Desarrollo Full-Stack",
      "Integraciones API",
      "Panel de Administración",
      "E-commerce Avanzado",
      "Soporte Dedicado 24/7",
      "Mantenimiento Incluido",
      "Consultoría Estratégica"
    ],
    cta: "Solicitar Propuesta",
    popular: false,
    color: "#32D74B"
  }
];

/** Paquetes de servicio adicionales */
const additionalPackages = [
  {
    icon: "videocam",
    title: "Video Production",
    description: "Paquete completo de producción de video con motion graphics y efectos visuales.",
    price: "Desde $3,000"
  },
  {
    icon: "palette",
    title: "Brand Identity",
    description: "Sistema de identidad visual completo con logo, paleta de colores y guía de marca.",
    price: "Desde $2,000"
  },
  {
    icon: "campaign",
    title: "Marketing Digital",
    description: "Estrategia de marketing digital con campañas en redes sociales y publicidad online.",
    price: "Desde $1,500/mes"
  }
];
---

<BaseLayout
  title="Paquetes - Daller"
  description="Elige el paquete perfecto para tu proyecto. Soluciones digitales escalables para cada necesidad y presupuesto."
>
  <!-- Hero Section -->
  <section class="relative min-h-[60vh] flex items-center justify-center overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-br from-surface-container-lowest via-surface to-surface-container"></div>
    
    <div class="relative z-10 max-w-[1200px] mx-auto w-full text-center px-6 md:px-12 pt-32">
      <span class="label-md text-sm text-[#32D74B] uppercase tracking-widest mb-6 block">Soluciones Digitales</span>
      <h1 class="heading-xl text-4xl sm:text-5xl md:text-6xl lg:text-7xl text-white max-w-4xl mx-auto mb-6">
        Nuestros <span class="text-[#32D74B]">Paquetes</span>
      </h1>
      <p class="body-lg text-lg md:text-xl text-white/90 max-w-2xl mx-auto mb-10">
        Elige la solución perfecta para tu proyecto. Todos nuestros paquetes incluyen diseño profesional y tecnología de vanguardia.
      </p>
    </div>
  </section>

  <!-- Paquetes Principales -->
  <section class="py-24 md:py-32 px-6 md:px-12 max-w-[1440px] mx-auto w-full">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 md:gap-8">
      {packages.map((pkg) => (
        <div class={`relative glass-panel p-6 md:p-8 lg:p-10 rounded-2xl md:rounded-3xl border ${pkg.popular ? 'shadow-[0_0_30px_rgba(181,53,246,0.2)]' : 'border-outline-variant/20'} group`} style={pkg.popular ? `border-color: ${pkg.color}80;` : undefined}>
          {pkg.popular && (
            <div class="absolute -top-3 left-1/2 transform -translate-x-1/2">
              <span class="bg-[#B535F6] text-white px-4 py-1.5 rounded-full text-xs font-semibold uppercase tracking-wider">
                Más Popular
              </span>
            </div>
          )}
          
          <div class="text-center mb-6 md:mb-8">
            <h3 class="heading-md text-xl md:text-2xl text-text-primary mb-2">{pkg.name}</h3>
            <div class="mb-3 md:mb-4 flex flex-col items-center">
              <span class="heading-xl text-3xl md:text-4xl lg:text-5xl" style={`color: ${pkg.color}`}>{pkg.price}</span>
              <span class="body-md text-text-muted text-xs md:text-sm">{pkg.period}</span>
            </div>
            <p class="body-md text-text-muted text-xs md:text-sm">{pkg.description}</p>
          </div>
          
          <ul class="space-y-2.5 md:space-y-4 mb-6 md:mb-8">
            {pkg.features.map((feature) => (
              <li class="flex items-start md:items-center gap-2.5 md:gap-3 text-text-primary body-md text-xs md:text-sm">
                <span class="w-2 h-2 rounded-full flex-shrink-0 mt-1 md:mt-0" style={`background-color: ${pkg.color}`}></span>
                {feature}
              </li>
            ))}
          </ul>
          
          <a 
            class={`w-full inline-flex items-center justify-center gap-2 px-6 md:px-8 py-3.5 md:py-4 rounded-full font-semibold transition-all duration-300 text-sm md:text-base ${
              pkg.popular 
                ? 'bg-[#B535F6] text-white hover:scale-[1.02] shadow-[0_4px_20px_rgba(181,53,246,0.4)]' 
                : 'border-2 border-[#32D74B] text-[#32D74B] hover:bg-[#32D74B] hover:text-surface-container-lowest'
            }`}
            href="/contact"
          >
            {pkg.cta}
            <span class="material-symbols-outlined" style="font-variation-settings: 'FILL' 0;">arrow_forward</span>
          </a>
        </div>
      ))}
    </div>
  </section>

  <!-- Paquetes Adicionales -->
  <section class="py-24 md:py-32 px-6 md:px-12 bg-surface-container-lowest">
    <div class="max-w-[1440px] mx-auto w-full">
      <div class="text-center mb-16 md:mb-24">
        <span class="label-md text-sm text-[#32D74B] uppercase tracking-widest mb-4 block">Servicios Adicionales</span>
        <h2 class="heading-lg text-3xl md:text-4xl lg:text-5xl text-text-primary mb-6">
          Paquetes Especializados
        </h2>
        <p class="body-lg text-lg text-text-muted max-w-2xl mx-auto">
          Complementa tu proyecto con servicios especializados para una solución completa.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 md:gap-8">
        {additionalPackages.map((pkg) => (
          <div class="glass-panel p-6 md:p-8 rounded-2xl md:rounded-3xl border border-outline-variant/20 group text-center">
            <div class="w-14 h-14 md:w-16 md:h-16 rounded-full bg-[#32D74B]/10 flex items-center justify-center mx-auto mb-5 md:mb-6 group-hover:bg-[#32D74B]/20 transition-colors">
              <span class="material-symbols-outlined text-2xl md:text-3xl text-[#32D74B]" style="font-variation-settings: 'FILL' 0;">{pkg.icon}</span>
            </div>
            <h3 class="heading-md text-lg md:text-xl text-text-primary mb-3">{pkg.title}</h3>
            <p class="body-md text-text-muted text-xs md:text-sm mb-4">{pkg.description}</p>
            <span class="heading-md text-base md:text-lg text-[#32D74B]">{pkg.price}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="py-24 md:py-32 px-6 md:px-12">
    <div class="max-w-[1200px] mx-auto w-full text-center">
      <h2 class="heading-lg text-3xl md:text-4xl lg:text-5xl text-text-primary mb-6">
        ¿Necesitas algo personalizado?
      </h2>
      <p class="body-lg text-lg text-text-muted max-w-2xl mx-auto mb-10">
        Cada proyecto es único. Contáctanos para crear un paquete a medida que se adapte perfectamente a tus necesidades.
      </p>
      <a class="btn-primary text-base md:text-lg px-8 md:px-10 py-4 md:py-5" href="/contact">
        Solicitar Presupuesto Personalizado
        <span class="material-symbols-outlined" style="font-variation-settings: 'FILL' 0;">arrow_forward</span>
      </a>
    </div>
  </section>
</BaseLayout>