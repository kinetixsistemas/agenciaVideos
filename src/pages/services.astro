---
/**
 * services.astro - Página de servicios
 *
 * Muestra los tres servicios principales con secciones dedicadas:
 * - Edición de Videos (Motion VFX)
 * - Diseño Gráfico (Identidad UI/UX)
 * - Páginas Web (React WebGL)
 *
 * Incluye sección "Nuestro Proceso" con 3 pasos
 * y un CTA final de conversión.
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import { services } from "../data/services";

/** Datos de cada servicio con IDs para anclaje */
const serviceSections = [
  {
    id: "edicion-de-videos",
    service: services[0],
    features: ["Motion Graphics", "VFX Compositing", "Color Grading", "Edición Cinematográfica"],
  },
  {
    id: "diseno-grafico",
    service: services[2],
    features: ["Identidad de Marca", "UI/UX Design", "Motion Design", "Packaging Digital"],
  },
  {
    id: "paginas-web",
    service: services[1],
    features: ["React & Next.js", "WebGL & Three.js", "Headless CMS", "Performance Optimization"],
  },
];
---

<BaseLayout
  title="Servicios - Electric Apple"
  description="Nuestra experiencia en edición de video, diseño gráfico y desarrollo web. Sintetizamos estructura brutalista con pulido de alta fidelidad."
>
  <!-- Contenido principal -->
  <main class="flex-grow pt-[120px] pb-[var(--section-gap)] px-[var(--page-margin-mobile)] md:px-[var(--page-margin-desktop)] max-w-[1440px] mx-auto w-full">
    <!-- Cabecera de sección -->
    <header class="mb-[80px] max-w-3xl">
      <h1 class="font-headline-lg-mobile text-headline-lg-mobile md:font-headline-lg md:text-headline-lg text-text-primary mb-6">Nuestra Experiencia</h1>
      <p class="font-body-lg text-body-lg text-text-muted">
        Sintetizamos estructura brutalista con pulido de alta fidelidad. Nuestras disciplinas se interconectan para forjar experiencias digitales que exigen atención e impulsan acción precisa.
      </p>
    </header>

    <!-- Secciones de servicios con anclaje -->
    {serviceSections.map((section, index) => (
      <section id={section.id} class="scroll-mt-32 mb-24">
        <div class={`grid grid-cols-1 lg:grid-cols-2 gap-12 items-center ${index % 2 !== 0 ? 'lg:direction-rtl' : ''}`}>
          <!-- Imagen del servicio -->
          <div class="relative rounded-[32px] overflow-hidden group">
            <img
              class="w-full h-[400px] lg:h-[500px] object-cover transition-transform duration-700 group-hover:scale-105"
              src={section.service.image}
              alt={section.service.title}
            />
            <div class="absolute inset-0 bg-gradient-to-t from-[#242426]/90 via-transparent to-transparent"></div>
            <div class="absolute bottom-8 left-8 flex gap-3">
              {section.service.tags.map((tag) => (
                <span class="bg-[#242426]/80 text-[#32D74B] px-5 py-2 rounded-full font-label-md text-label-md border border-[#32D74B]/30 backdrop-blur-md">{tag}</span>
              ))}
            </div>
          </div>

          <!-- Contenido del servicio -->
          <div class={`flex flex-col gap-6 ${index % 2 !== 0 ? 'lg:direction-ltr' : ''}`}>
            <div class="w-14 h-14 rounded-full bg-[#32D74B]/10 flex items-center justify-center text-[#32D74B]">
              <span class="material-symbols-outlined text-2xl" style="font-variation-settings: 'FILL' 0;">{section.service.icon}</span>
            </div>
            <h2 class="font-headline-lg-mobile text-headline-lg-mobile md:font-headline-lg md:text-headline-lg text-text-primary">{section.service.title}</h2>
            <p class="font-body-lg text-body-lg text-text-muted">
              {section.service.description}
            </p>
            <ul class="grid grid-cols-2 gap-4 mt-4">
              {section.features.map((feature) => (
                <li class="flex items-center gap-3 text-text-primary font-body-md">
                  <span class="w-2 h-2 rounded-full bg-[#32D74B] flex-shrink-0"></span>
                  {feature}
                </li>
              ))}
            </ul>
            <a class="mt-6 inline-flex items-center justify-center gap-3 bg-[#32D74B] text-surface-container-lowest font-button text-button rounded-full px-8 py-4 hover:scale-[1.02] transition-transform duration-200 active:scale-95 w-fit shadow-[0_4px_20px_rgba(50,215,75,0.3)]" href={section.service.href}>
              {section.service.cta} <span class="material-symbols-outlined" style="font-variation-settings: 'FILL' 0;">arrow_forward</span>
            </a>
          </div>
        </div>
      </section>
    ))}

    <!-- Sección "Nuestro Proceso" -->
    <section class="mt-[var(--section-gap)]">
      <h2 class="font-headline-lg-mobile text-headline-lg-mobile md:font-headline-lg md:text-headline-lg text-text-primary mb-12">Nuestro Proceso</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-[var(--gutter)]">
        <!-- Paso 1: Consulta -->
        <div class="glass-panel p-10 rounded-[32px] border border-outline-variant/20 relative overflow-hidden group hover-lift-card">
          <div class="text-[#32D74B] font-display-xl text-display-xl opacity-10 absolute -top-4 -right-4 transition-transform group-hover:scale-110 duration-500">01</div>
          <h3 class="font-headline-md text-headline-md text-text-primary mb-4 relative z-10">Consulta</h3>
          <p class="font-body-md text-body-md text-text-muted relative z-10">Definimos el objetivo estratégico, analizamos el panorama y establecemos el plan estructural para tu presencia digital.</p>
        </div>
        <!-- Paso 2: Ejecución -->
        <div class="glass-panel p-10 rounded-[32px] border border-outline-variant/20 relative overflow-hidden group hover-lift-card">
          <div class="text-[#32D74B] font-display-xl text-display-xl opacity-10 absolute -top-4 -right-4 transition-transform group-hover:scale-110 duration-500">02</div>
          <h3 class="font-headline-md text-headline-md text-text-primary mb-4 relative z-10">Ejecución</h3>
          <p class="font-body-md text-body-md text-text-muted relative z-10">Nuestras disciplinas se interconectan. Sintetizamos diseño, movimiento y código en una arquitectura cohesiva y de alto rendimiento.</p>
        </div>
        <!-- Paso 3: Entrega -->
        <div class="glass-panel p-10 rounded-[32px] border border-outline-variant/20 relative overflow-hidden group hover-lift-card">
          <div class="text-[#32D74B] font-display-xl text-display-xl opacity-10 absolute -top-4 -right-4 transition-transform group-hover:scale-110 duration-500">03</div>
          <h3 class="font-headline-md text-headline-md text-text-primary mb-4 relative z-10">Entrega</h3>
          <p class="font-body-md text-body-md text-text-muted relative z-10">Despliegue de un producto preciso y sin piedad. Entregamos las llaves de una plataforma diseñada para máximo impacto.</p>
        </div>
      </div>
    </section>

    <!-- CTA final -->
    <section class="mt-[var(--section-gap)] py-[120px] px-8 glass-panel rounded-[32px] border border-outline-variant/20 text-center relative overflow-hidden">
      <div class="max-w-3xl mx-auto relative z-10">
        <h2 class="font-headline-lg-mobile text-headline-lg-mobile md:font-headline-lg md:text-headline-lg text-text-primary mb-6">¿Listo para empezar?</h2>
        <p class="font-body-lg text-body-lg text-text-muted mb-12">
          No solo construimos productos digitales; ingenieriamos ventajas competitivas. Asociado con Electric Apple para redefinir el estándar digital de tu industria.
        </p>
        <a
          class="inline-flex items-center justify-center bg-[#32D74B] text-surface font-button text-button rounded-full px-12 py-6 text-lg hover:scale-105 transition-transform duration-300 shadow-[0_0_40px_rgba(50,215,75,0.4)]"
          href="/contact"
        >
          Consultar a un Experto Ahora
        </a>
      </div>
    </section>
  </main>
</BaseLayout>
