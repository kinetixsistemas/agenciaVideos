---
/**
 * services.astro - Página de servicios
 *
 * Muestra los tres servicios principales con enlaces a páginas dedicadas.
 * Responsive mobile-first con touch targets 44px+.
 */
import BaseLayout from "../layouts/BaseLayout.astro";

const serviceSections = [
  {
    id: "edicion-de-videos",
    icon: "videocam",
    tagline: "Motion VFX",
    title: "Edición de Videos",
    description: "Transformamos footage crudo en narrativas cinematográficas que cautivan. Desde color grading profesional hasta motion graphics de última generación.",
    features: ["Motion Graphics", "VFX Compositing", "Color Grading", "Edición Cinematográfica"],
    image: "https://images.unsplash.com/photo-1574717024653-61fd2cf4d44d?w=1200&h=675&fit=crop&q=80",
    tags: ["Motion", "VFX"],
    cta: "Ver Servicio Completo",
    href: "/video-editing"
  },
  {
    id: "paginas-web",
    icon: "code",
    tagline: "React WebGL",
    title: "Páginas Web",
    description: "Arquitecturas de alto rendimiento construidas sobre stacks modernos. Entornos resilientes e interactivos que fusionan estética táctil con ejecución técnica impecable.",
    features: ["React & Next.js", "WebGL & Three.js", "Headless CMS", "Performance Optimization"],
    image: "https://images.unsplash.com/photo-1460925895917-afdab827c52f?w=1200&h=675&fit=crop&q=80",
    tags: ["React", "WebGL"],
    cta: "Ver Servicio Completo",
    href: "/web-development"
  }
];
---

<BaseLayout
  title="Servicios - Daller"
  description="Nuestra experiencia en edición de video, diseño gráfico y desarrollo web. Sintetizamos estructura brutalista con pulido de alta fidelidad."
>
  <div class="flex-grow pt-24 md:pt-[120px] pb-16 md:pb-24 px-5 md:px-12 max-w-[1440px] mx-auto w-full">
    <!-- Header -->
    <header class="mb-12 md:mb-20 max-w-3xl">
      <h1 class="heading-lg text-3xl md:text-4xl lg:text-5xl text-text-primary mb-4 md:mb-6">Nuestra Experiencia</h1>
      <p class="body-lg text-base md:text-lg text-text-muted">
        Sintetizamos estructura brutalista con pulido de alta fidelidad. Nuestras disciplinas se interconectan para forjar experiencias digitales que exigen atención e impulsan acción precisa.
      </p>
    </header>

    <!-- Service sections -->
    {serviceSections.map((section, index) => (
      <section id={section.id} class="scroll-mt-32 mb-16 md:mb-24">
        <div class={`grid grid-cols-1 lg:grid-cols-2 gap-8 md:gap-12 items-center`}>
          <!-- Image -->
          <div class={`relative rounded-3xl overflow-hidden group ${index % 2 !== 0 ? 'lg:order-2' : ''}`}>
            <img
              class="w-full h-[280px] md:h-[400px] lg:h-[500px] object-cover transition-transform duration-700 group-hover:scale-105"
              src={section.image}
              alt={section.title}
              loading="lazy"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-[#242426]/90 via-transparent to-transparent"></div>
            <div class="absolute bottom-4 md:bottom-8 left-4 md:left-8 flex gap-2 md:gap-3">
              {section.tags.map((tag) => (
                <span class="bg-[#242426]/80 text-[#32D74B] px-3 md:px-5 py-1.5 md:py-2 rounded-full text-xs md:text-sm font-semibold border border-[#32D74B]/30 backdrop-blur-md">{tag}</span>
              ))}
            </div>
          </div>

          <!-- Content -->
          <div class={`flex flex-col gap-5 md:gap-6 ${index % 2 !== 0 ? 'lg:order-1' : ''}`}>
            <div class="w-12 h-12 md:w-14 md:h-14 rounded-full bg-[#32D74B]/10 flex items-center justify-center text-[#32D74B]">
              <span class="material-symbols-outlined text-xl md:text-2xl" style="font-variation-settings: 'FILL' 0;">{section.icon}</span>
            </div>
            <h2 class="heading-lg text-2xl md:text-3xl lg:text-4xl text-text-primary">{section.title}</h2>
            <p class="body-lg text-base text-text-muted">
              {section.description}
            </p>
            <ul class="grid grid-cols-1 sm:grid-cols-2 gap-2 md:gap-3 mt-2">
              {section.features.map((feature) => (
                <li class="flex items-center gap-3 text-sm md:text-base text-text-primary min-h-[36px]">
                  <span class="w-2 h-2 rounded-full bg-[#32D74B] flex-shrink-0"></span>
                  {feature}
                </li>
              ))}
            </ul>
            <a class="mt-4 inline-flex items-center justify-center gap-2 bg-[#32D74B] text-surface-container-lowest font-semibold text-sm md:text-base rounded-full px-6 md:px-8 py-3.5 md:py-4 hover:scale-[1.02] transition-transform duration-200 active:scale-95 w-fit shadow-[0_4px_20px_rgba(50,215,75,0.3)] min-h-[44px]" href={section.href}>
              {section.cta} <span class="material-symbols-outlined text-lg" style="font-variation-settings: 'FILL' 0;">arrow_forward</span>
            </a>
          </div>
        </div>
      </section>
    ))}

    <!-- Process -->
    <section class="mt-16 md:mt-24">
      <h2 class="heading-lg text-2xl md:text-3xl lg:text-4xl text-text-primary mb-8 md:mb-12">Nuestro Proceso</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4 md:gap-6">
        <div class="glass-panel p-6 md:p-10 rounded-3xl border border-outline-variant/20 relative overflow-hidden group hover-lift-card">
          <div class="text-[#32D74B] text-5xl md:text-7xl font-extrabold opacity-10 absolute -top-2 -right-2 transition-transform group-hover:scale-110 duration-500">01</div>
          <h3 class="heading-md text-lg md:text-xl text-text-primary mb-3 md:mb-4 relative z-10">Consulta</h3>
          <p class="body-md text-sm md:text-base text-text-muted relative z-10">Definimos el objetivo estratégico, analizamos el panorama y establecemos el plan estructural para tu presencia digital.</p>
        </div>
        <div class="glass-panel p-6 md:p-10 rounded-3xl border border-outline-variant/20 relative overflow-hidden group hover-lift-card">
          <div class="text-[#32D74B] text-5xl md:text-7xl font-extrabold opacity-10 absolute -top-2 -right-2 transition-transform group-hover:scale-110 duration-500">02</div>
          <h3 class="heading-md text-lg md:text-xl text-text-primary mb-3 md:mb-4 relative z-10">Ejecución</h3>
          <p class="body-md text-sm md:text-base text-text-muted relative z-10">Nuestras disciplinas se interconectan. Sintetizamos diseño, movimiento y código en una arquitectura cohesiva y de alto rendimiento.</p>
        </div>
        <div class="glass-panel p-6 md:p-10 rounded-3xl border border-outline-variant/20 relative overflow-hidden group hover-lift-card">
          <div class="text-[#32D74B] text-5xl md:text-7xl font-extrabold opacity-10 absolute -top-2 -right-2 transition-transform group-hover:scale-110 duration-500">03</div>
          <h3 class="heading-md text-lg md:text-xl text-text-primary mb-3 md:mb-4 relative z-10">Entrega</h3>
          <p class="body-md text-sm md:text-base text-text-muted relative z-10">Despliegue de un producto preciso y sin piedad. Entregamos las llaves de una plataforma diseñada para máximo impacto.</p>
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="mt-16 md:mt-24 py-12 md:py-24 px-5 md:px-8 glass-panel rounded-3xl border border-outline-variant/20 text-center relative overflow-hidden">
      <div class="max-w-3xl mx-auto relative z-10">
        <h2 class="heading-lg text-2xl md:text-3xl lg:text-4xl text-text-primary mb-4 md:mb-6">¿Listo para empezar?</h2>
        <p class="body-lg text-base md:text-lg text-text-muted mb-8 md:mb-12">
          No solo construimos productos digitales; ingenieriamos ventajas competitivas. Asociado con Daller para redefinir el estándar digital de tu industria.
        </p>
        <a
          class="inline-flex items-center justify-center bg-[#32D74B] text-surface font-semibold text-base md:text-lg rounded-full px-8 md:px-12 py-4 md:py-6 hover:scale-105 transition-transform duration-300 shadow-[0_0_40px_rgba(50,215,75,0.4)] min-h-[48px]"
          href="/contact"
        >
          Consultar a un Experto Ahora
        </a>
      </div>
    </section>
  </div>
</BaseLayout>
