---
/**
 * projects.astro - Página de proyectos/portfolio
 *
 * Layout inmersivo con proyectos alternados.
 * Responsive mobile-first con touch targets 44px+.
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import { projects } from "../data/projects";
---

<BaseLayout
  title="Proyectos - Daller"
  description="Una galería curada de experiencias digitales diseñadas con precisión, que conectan energía brutalista con modernismo de alta gama."
>
  <div class="flex-grow pt-24 md:pt-[120px] pb-16 md:pb-24 w-full">
    <div class="max-w-[1440px] mx-auto px-5 md:px-12">
      <!-- Header -->
      <header class="mb-12 md:mb-24 max-w-4xl">
        <h1 class="heading-xl text-4xl md:text-5xl lg:text-7xl text-text-primary mb-4 md:mb-6 uppercase leading-tight">Obras<br /><span class="text-primary">Selectas</span></h1>
        <p class="body-lg text-base md:text-lg text-text-muted max-w-2xl">Una galería curada de experiencias digitales diseñadas con precisión, que conectan energía brutalista con modernismo de alta gama.</p>
      </header>

      <!-- Projects list -->
      <div class="flex flex-col gap-16 md:gap-32">
        {projects.map((project, index) => (
          <section class="group relative rounded-3xl overflow-hidden bg-surface-container-low border border-outline-variant/10 flex flex-col lg:flex-row h-auto lg:h-[600px]">
            <!-- Image -->
            <div class={`w-full lg:w-3/5 h-[260px] md:h-[400px] lg:h-full relative overflow-hidden ${index % 2 === 0 ? 'order-1 lg:order-2' : 'order-1'}`}>
              <div
                class="absolute inset-0 bg-cover bg-center transform group-hover:scale-105 transition-transform duration-700 ease-[cubic-bezier(0.25,1,0.5,1)]"
                style={`background-image: url('${project.image}')`}
              ></div>
              <div class="absolute inset-0 bg-surface/20 group-hover:bg-transparent transition-colors duration-500 z-10 flex items-center justify-center">
                <div class="w-16 h-16 md:w-20 md:h-20 rounded-full bg-surface/50 backdrop-blur-md flex items-center justify-center border border-text-muted/20 text-text-primary group-hover:scale-110 group-hover:bg-primary/20 transition-all duration-300">
                  <span class="material-symbols-outlined text-2xl md:text-4xl" style="font-variation-settings: 'FILL' 1;">play_arrow</span>
                </div>
              </div>
              <div class="absolute inset-0 bg-gradient-to-t from-[#131315] via-transparent to-transparent lg:hidden"></div>
            </div>

            <!-- Info -->
            <div class={`w-full lg:w-2/5 p-6 md:p-8 lg:p-16 flex flex-col justify-center ${index % 2 === 0 ? 'order-2 lg:order-1 glass-panel lg:border-r lg:border-outline-variant/10' : 'order-2 glass-panel lg:border-l lg:border-outline-variant/10'} z-20`}>
              <div class="flex flex-wrap items-center gap-2 md:gap-4 mb-4 md:mb-6">
                <span class="px-3 md:px-4 py-1.5 md:py-2 rounded-full bg-surface-container-highest text-primary text-xs uppercase tracking-wider border border-outline-variant/20">{project.category}</span>
                <span class="px-3 md:px-4 py-1.5 md:py-2 rounded-full bg-surface-container-highest text-primary text-xs uppercase tracking-wider border border-outline-variant/20">{project.tag}</span>
              </div>
              <h2 class="heading-lg text-xl md:text-2xl lg:text-3xl text-text-primary mb-4 md:mb-6">{project.title}</h2>
              <p class="body-lg text-sm md:text-base text-text-muted mb-6 md:mb-10">{project.description}</p>
              <a class="inline-flex w-fit items-center justify-center gap-2 bg-[#32D74B] text-[#131315] font-semibold text-sm md:text-base rounded-full px-6 md:px-8 py-3 md:py-4 hover:scale-[1.02] transition-transform duration-200 active:scale-95 neon-glow-emerald min-h-[44px]" href="/contact">
                {project.cta} <span class="material-symbols-outlined text-lg" style="font-variation-settings: 'FILL' 0;">arrow_forward</span>
              </a>
            </div>
          </section>
        ))}
      </div>
    </div>
  </div>

  <!-- CTA final -->
  <section class="py-12 md:py-24 px-5 md:px-12 bg-surface-container-highest w-full border-t border-outline-variant/10">
    <div class="max-w-[1024px] mx-auto text-center flex flex-col items-center gap-6 md:gap-8">
      <h2 class="heading-lg text-2xl md:text-3xl lg:text-4xl leading-tight text-text-primary">
        ¿Listo para crear el <span class="text-[#B535F6]">tuyo?</span>
      </h2>
      <p class="body-lg text-base md:text-lg text-text-muted max-w-2xl">
        Asociado con Daller para llevar tus conceptos técnicos y visuales más ambiciosos a la vida. No hacemos promedios.
      </p>
      <a class="mt-4 md:mt-8 inline-flex items-center justify-center px-8 md:px-12 py-4 md:py-6 rounded-full bg-[#32D74B] text-[#131315] font-bold text-base md:text-lg hover:scale-[1.05] transition-transform duration-300 neon-glow-emerald min-h-[48px]" href="/contact">
        Consultar a un Experto
      </a>
    </div>
  </section>
</BaseLayout>
