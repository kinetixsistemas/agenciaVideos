---
/**
 * web-development.astro - Página de Desarrollo Web
 *
 * Estructura semántica completa:
 * - Hero con imagen de fondo y CTA
 * - Galería de trabajos destacados
 * - Cards de precios con 3 planes
 * - FAQ con acordeón interactivo
 * - CTA final de conversión
 */
import BaseLayout from "../layouts/BaseLayout.astro";

/** Datos de la galería */
const gallery = [
  {
    title: "Aura Tech",
    category: "Plataforma SaaS",
    image: "https://images.unsplash.com/photo-1460925895917-afdab827c52f?w=800&h=600&fit=crop&q=80",
    alt: "Dashboard de plataforma tecnológica con métricas en tiempo real y gráficos interactivos"
  },
  {
    title: "Lumina Motors",
    category: "Sitio Corporativo",
    image: "https://images.unsplash.com/photo-1503376780353-7e6692767b70?w=800&h=600&fit=crop&q=80",
    alt: "Sitio web de lujo para marca automotriz con diseño inmersivo y 3D"
  },
  {
    title: "Green Valley",
    category: "E-commerce",
    image: "https://images.unsplash.com/photo-1556742049-0cfed4f6a45d?w=800&h=600&fit=crop&q=80",
    alt: "Tienda online de productos orgánicos con carrito de compras moderno"
  },
  {
    title: "Fitness Pro",
    category: "Aplicación Web",
    image: "https://images.unsplash.com/photo-1551288049-bebda4e38f71?w=800&h=600&fit=crop&q=80",
    alt: "Aplicación de fitness con seguimiento de entrenamientos y estadísticas"
  },
  {
    title: "Urban Eats",
    category: "Plataforma de Delivery",
    image: "https://images.unsplash.com/photo-1565299624946-b28f40a0ae38?w=800&h=600&fit=crop&q=80",
    alt: "Plataforma de delivery de comida con mapa interactivo y seguimiento en tiempo real"
  },
  {
    title: "Neon Nights",
    category: "Experiencia WebGL",
    image: "https://images.unsplash.com/photo-1550751827-4bd374c3f58b?w=800&h=600&fit=crop&q=80",
    alt: "Experiencia web inmersiva con gráficos 3D y efectos de partículas"
  }
];

/** Planes de precios */
const plans = [
  {
    name: "Start",
    price: "$199.99",
    period: "por proyecto",
    description: "Landing page profesional.",
    features: [
      "Landing page profesional optimizada para presencia digital.",
      "Diseño adaptable a escritorio, tablet y móvil.",
      "Optimización SEO básica para motores de búsqueda.",
      "Formulario de contacto.",
      "Dominio + hosting + Certificado SSL por 1 año.",
      "Entrega de 3 a 5 días."
    ],
    cta: "Elegir Start",
    popular: false,
    icon: "language"
  },
  {
    name: "Bussisness Pro",
    price: "$299.99",
    period: "por proyecto",
    description: "Sitio web profesional para empresas en crecimiento.",
    features: [
      "Hasta 6 páginas de alto impacto.",
      "Arquitectura de contenido orientada a conversión.",
      "Diseño responsive y adaptavivo al dispositivo.",
      "Optimización SEO técnica avanzada.",
      "Integración de analytics congifurado.",
      "Optimizacion de rendimiento puntucion 90+ en Lighthouse.",
      "Dominio + hosting + Certificado SSL por 1 año.",
      "Entrega de 7 a 10 días.",
      "Soporte 60 días"
    ],
    cta: "Elegir Business Pro",
    popular: true,
    icon: "code"
  },
  {
    name: "Elite VIP",
    price: "Desde $499.99",
    period: "presupuesto a medida",
    description: "Plataforma web escalable con funcionalidades avanzadas.",
    features: [
      "Arquitectura full-stack",
      "APIs y microservicios",
      "Bases de datos",
      "E-commerce avanzado",
      "Sistemas de usuarios",
      "Integraciones externas",
      "Performance optimizado",
      "SEO avanzado",
      "Dominio + hosting + Certificado SSL por 1 año.",
      "Entrega desde las 3 semanas según alcance",
      "Soporte dedicado 3 meses"
    ],
    cta: "Solicitar Propuesta",
    popular: false,
    icon: "cloud"
  }
];

/** FAQ */
const faq = [
  {
    question: "¿Qué tecnologías utilizan para desarrollo web?",
    answer: "Utilizamos React, Next.js, Astro, TypeScript, Tailwind CSS. Para experiencias 3D e interactivas, trabajamos con WebGL y Three.js. Seleccionamos la mejor stack según las necesidades del proyecto."
  },
  {
    question: "¿Cuánto tiempo toma desarrollar un sitio web?",
    answer: "Una landing page puede estar lista en 2-3 semanas. Un sitio corporativo de 4-6 semanas. Plataformas más complejas pueden requerir 2-3 meses. Siempre proporcionamos un cronograma detallado."
  },
  {
    question: "¿El sitio será responsive y accesible?",
    answer: "Sí, todos nuestros sitios están optimizados para todos los dispositivos (mobile-first) y siguen las guías WCAG 2.1 AA para accesibilidad, incluyendo contraste, navegación por teclado y lectores de pantalla."
  },
  {
    question: "¿Ofrecen mantenimiento después del lanzamiento?",
    answer: "Sí, ofrecemos planes de mantenimiento mensual que incluyen actualizaciones de seguridad, monitoreo de rendimiento y soporte técnico. Todos los paquetes incluyen soporte inicial."
  },
  {
    question: "¿Pueden trabajar con nuestro equipo interno?",
    answer: "Sí, colaboramos estrechamente con equipos internos de desarrollo, diseño y marketing. Ofrecemos integración fluida y documentación completa para facilitar la transición."
  }
];
---

<BaseLayout
  title="Desarrollo Web - Daller"
  description="Servicio profesional de desarrollo web con tecnologías modernas. React, Next.js, Astro, WebGL. Plataformas de alto rendimiento."
>
    <!-- HERO -->
    <section
      class="relative min-h-dvh flex items-center justify-center overflow-hidden"
      aria-labelledby="web-hero-heading"
    >
      <div class="absolute inset-0 z-0">
        <img
          src="https://images.unsplash.com/photo-1460925895917-afdab827c52f?w=1920&h=1080&fit=crop&q=80"
          alt=""
          class="w-full h-full object-cover hero-bg-image"
          aria-hidden="true"
        />
        <div class="absolute inset-0 bg-gradient-to-b from-surface/70 via-surface/50 to-surface/95"></div>
      </div>

      <!-- Elementos decorativos de código -->
      <div class="absolute inset-0 opacity-[0.03]" aria-hidden="true">
        <div class="absolute top-1/4 left-[10%] text-[#32D74B] font-mono text-sm transform -rotate-12 select-none">
          &lt;div className="hero"&gt;
        </div>
        <div class="absolute bottom-1/3 right-[10%] text-[#B535F6] font-mono text-sm transform rotate-12 select-none">
          const app = createApp();
        </div>
      </div>

      <div class="relative z-10 max-w-[1200px] mx-auto w-full text-center px-6 md:px-12 hero-content">
        <div class="inline-flex items-center gap-2 bg-[#32D74B]/10 border border-[#32D74B]/30 rounded-full px-5 py-2 mb-8">
          <span class="material-symbols-outlined text-[#32D74B] text-lg" style="font-variation-settings: 'FILL' 0;">code</span>
          <span class="label-md text-sm text-[#32D74B] uppercase tracking-wider">React WebGL</span>
        </div>

        <h1
          id="web-hero-heading"
          class="heading-xl text-5xl sm:text-6xl md:text-7xl lg:text-8xl text-white max-w-5xl mx-auto mb-6"
          style="text-shadow: 0 4px 40px rgba(0,0,0,0.8);"
        >
          Desarrollo <span class="text-[#32D74B]">Web</span>
        </h1>

        <p
          class="body-lg text-xl md:text-2xl text-white/90 max-w-2xl mx-auto mb-10"
          style="text-shadow: 0 2px 20px rgba(0,0,0,0.9);"
        >
          Arquitecturas de alto rendimiento. Plataformas que escalan y experiencias que impactan.
        </p>

        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a class="btn-primary text-base md:text-lg px-8 md:px-10 py-4 md:py-5" href="/contact">
            Construir tu Plataforma
            <span class="material-symbols-outlined" style="font-variation-settings: 'FILL' 0;">arrow_forward</span>
          </a>
          <a
            class="inline-flex items-center justify-center gap-3 px-8 md:px-10 py-4 md:py-5 rounded-full border-2 border-white/30 text-white font-semibold hover:bg-white/10 transition-all duration-300 text-base md:text-lg"
            href="#gallery"
          >
            <span class="material-symbols-outlined" style="font-variation-settings: 'FILL' 0;">web</span>
            Ver Proyectos
          </a>
        </div>
      </div>

      <div class="absolute bottom-8 left-1/2 -translate-x-1/2 z-10 flex flex-col items-center gap-2 opacity-70" aria-hidden="true">
        <span class="label-md text-xs text-white/60 uppercase tracking-widest">Scroll</span>
        <div class="w-6 h-10 rounded-full border-2 border-white/30 flex justify-center pt-2">
          <div class="w-1 h-3 bg-white/60 rounded-full animate-bounce"></div>
        </div>
      </div>
    </section>

    <!-- GALERÍA -->
    <section
      id="gallery"
      class="py-24 md:py-32 px-6 md:px-12 bg-surface"
      aria-labelledby="gallery-heading"
    >
      <div class="max-w-[1440px] mx-auto w-full">
        <header class="text-center mb-16 md:mb-20">
          <span class="label-md text-sm text-[#32D74B] uppercase tracking-widest mb-4 block">Portfolio</span>
          <h2 id="gallery-heading" class="heading-lg text-3xl md:text-4xl lg:text-5xl text-text-primary mb-6">
            Proyectos Destacados
          </h2>
          <p class="body-lg text-lg text-text-muted max-w-2xl mx-auto">
            Plataformas web que han transformado negocios y escalado resultados.
          </p>
        </header>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 md:gap-8">
          {gallery.map((item, index) => (
            <article
              class="group relative rounded-3xl overflow-hidden glass-panel hover-lift-card cursor-pointer gallery-item"
              style={`animation-delay: ${index * 100}ms`}
            >
              <div class="aspect-[4/3] relative overflow-hidden">
                <img
                  src={item.image}
                  alt={item.alt}
                  class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
                  loading="lazy"
                  width="800"
                  height="600"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-surface/90 via-surface/20 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
                <div class="absolute inset-0 flex flex-col justify-end p-6 opacity-0 group-hover:opacity-100 transition-opacity duration-300">
                  <span class="label-md text-xs text-[#32D74B] uppercase tracking-widest mb-2">{item.category}</span>
                  <h3 class="heading-md text-xl text-white">{item.title}</h3>
                </div>
                <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-16 h-16 rounded-full bg-[#32D74B] flex items-center justify-center opacity-0 group-hover:opacity-100 transition-all duration-300 transform scale-75 group-hover:scale-100 shadow-[0_0_30px_rgba(50,215,75,0.5)]">
                  <span class="material-symbols-outlined text-3xl text-surface-container-lowest" style="font-variation-settings: 'FILL' 1;">open_in_new</span>
                </div>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- PRECIOS -->
    <section
      class="py-24 md:py-32 px-6 md:px-12 bg-surface-container-lowest"
      aria-labelledby="pricing-heading"
    >
      <div class="max-w-[1440px] mx-auto w-full">
        <header class="text-center mb-16 md:mb-20">
          <span class="label-md text-sm text-[#32D74B] uppercase tracking-widest mb-4 block">Precios</span>
          <h2 id="pricing-heading" class="heading-lg text-3xl md:text-4xl lg:text-5xl text-text-primary mb-6">
            Planes de Desarrollo
          </h2>
          <p class="body-lg text-lg text-text-muted max-w-2xl mx-auto">
            Invierte en una plataforma web que escale con tu negocio.
          </p>
        </header>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 md:gap-8 max-w-5xl mx-auto">
          {plans.map((plan) => (
            <article
              class={`relative glass-panel p-6 md:p-8 rounded-2xl md:rounded-3xl border ${
                plan.popular
                  ? 'border-[#B535F6]/50 shadow-[0_0_40px_rgba(181,53,246,0.15)]'
                  : 'border-outline-variant/20'
              } pricing-card`}
              aria-labelledby={`plan-${plan.name}`}
            >
              {plan.popular && (
                <div class="absolute -top-3 left-1/2 -translate-x-1/2">
                  <span class="bg-[#B535F6] text-white px-4 py-1.5 rounded-full label-md text-xs uppercase tracking-wider">
                    Más Popular
                  </span>
                </div>
              )}
              <div class="text-center mb-6 md:mb-8">
                <div class="w-12 h-12 md:w-14 md:h-14 rounded-full bg-[#32D74B]/10 flex items-center justify-center mx-auto mb-4">
                  <span class="material-symbols-outlined text-xl md:text-2xl text-[#32D74B]" style="font-variation-settings: 'FILL' 0;">{plan.icon}</span>
                </div>
                <h3 id={`plan-${plan.name}`} class="heading-md text-xl md:text-2xl text-text-primary mb-2">{plan.name}</h3>
                <div class="mb-3 flex flex-col items-center">
                  <span class={`heading-xl text-3xl md:text-4xl ${plan.popular ? 'text-[#B535F6]' : 'text-[#32D74B]'}`}>{plan.price}</span>
                  <span class="body-md text-text-muted text-xs md:text-sm">{plan.period}</span>
                </div>
                <p class="body-md text-text-muted text-xs md:text-sm">{plan.description}</p>
              </div>
              <ul class="space-y-2.5 md:space-y-3 mb-6 md:mb-8" role="list">
                {plan.features.map((feature) => (
                  <li class="flex items-start gap-2.5 md:gap-3 text-text-primary body-md text-xs md:text-sm">
                    <span class="material-symbols-outlined text-[#32D74B] text-base md:text-lg mt-0.5 flex-shrink-0" style="font-variation-settings: 'FILL' 1;">check_circle</span>
                    <span>{feature}</span>
                  </li>
                ))}
              </ul>
              <a
                class={`w-full inline-flex items-center justify-center gap-2 px-6 md:px-8 py-3.5 md:py-4 rounded-full font-semibold transition-all duration-300 text-sm md:text-base ${
                  plan.popular
                    ? 'bg-[#B535F6] text-white hover:scale-[1.02] shadow-[0_4px_20px_rgba(181,53,246,0.4)]'
                    : 'border-2 border-[#32D74B] text-[#32D74B] hover:bg-[#32D74B] hover:text-surface-container-lowest'
                }`}
                href="/contact"
                aria-label={`${plan.cta} - plan ${plan.name}`}
              >
                {plan.cta}
                <span class="material-symbols-outlined" style="font-variation-settings: 'FILL' 0;">arrow_forward</span>
              </a>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section
      class="py-24 md:py-32 px-6 md:px-12"
      aria-labelledby="faq-heading"
    >
      <div class="max-w-[800px] mx-auto w-full">
        <header class="text-center mb-16">
          <span class="label-md text-sm text-[#32D74B] uppercase tracking-widest mb-4 block">FAQ</span>
          <h2 id="faq-heading" class="heading-lg text-3xl md:text-4xl text-text-primary mb-6">
            Preguntas Frecuentes
          </h2>
        </header>
        <div class="space-y-4" role="list">
          {faq.map((item, index) => (
            <div class="glass-panel rounded-2xl border border-outline-variant/20 overflow-hidden faq-item" role="listitem">
              <button
                class="w-full px-6 py-5 text-left flex justify-between items-center gap-4 hover:bg-surface-container-high/30 transition-colors"
                aria-expanded="false"
                aria-controls={`faq-answer-${index}`}
              >
                <span class="heading-md text-base md:text-lg text-text-primary">{item.question}</span>
                <span class="material-symbols-outlined text-[#32D74B] transform transition-transform duration-300 flex-shrink-0">expand_more</span>
              </button>
              <div id={`faq-answer-${index}`} class="faq-answer hidden px-6 pb-6" role="region">
                <p class="body-md text-text-muted leading-relaxed">{item.answer}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section
      class="py-24 md:py-32 px-6 md:px-12 bg-surface-container-lowest"
      aria-labelledby="cta-heading"
    >
      <div class="max-w-[1000px] mx-auto w-full text-center">
        <h2 id="cta-heading" class="heading-lg text-3xl md:text-4xl lg:text-5xl text-text-primary mb-6">
          ¿Listo para construir tu plataforma?
        </h2>
        <p class="body-lg text-lg text-text-muted max-w-2xl mx-auto mb-10">
          Nuestro equipo de desarrollo está listo para crear una solución web que supere tus expectativas.
        </p>
        <a class="btn-primary text-base md:text-lg px-8 md:px-10 py-4 md:py-5" href="/contact">
          Iniciar Desarrollo
          <span class="material-symbols-outlined" style="font-variation-settings: 'FILL' 0;">arrow_forward</span>
        </a>
      </div>
    </section>
</BaseLayout>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  function initWebPage() {
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (prefersReducedMotion) return;

    const heroContent = document.querySelector('.hero-content');
    const heroBg = document.querySelector('.hero-bg-image');

    if (heroContent) {
      const tl = gsap.timeline({ delay: 0.2 });
      tl.from(heroContent.querySelector('h1'), { y: 60, opacity: 0, duration: 1, ease: "power3.out" })
        .from(heroContent.querySelector('p'), { y: 40, opacity: 0, duration: 0.8, ease: "power3.out" }, "-=0.6")
        .from(heroContent.querySelectorAll('.btn-primary, a[href="#gallery"]'), { y: 30, opacity: 0, scale: 0.9, duration: 0.6, ease: "back.out(1.7)", stagger: 0.15 }, "-=0.4");
    }

    if (heroBg) {
      gsap.to(heroBg, { y: 200, scale: 1.1, ease: "none", scrollTrigger: { trigger: heroBg.closest('section'), start: "top top", end: "bottom top", scrub: true } });
    }

    gsap.from('.gallery-item', { y: 60, opacity: 0, duration: 0.8, stagger: 0.12, ease: "power3.out", scrollTrigger: { trigger: '#gallery', start: "top 80%", toggleActions: "play none none none" } });
    gsap.from('.pricing-card', { y: 80, opacity: 0, duration: 0.8, stagger: 0.15, ease: "power3.out", scrollTrigger: { trigger: '[aria-labelledby="pricing-heading"]', start: "top 80%", toggleActions: "play none none none" } });

    document.querySelectorAll('.faq-item button').forEach((button) => {
      button.addEventListener('click', () => {
        const isExpanded = button.getAttribute('aria-expanded') === 'true';
        const answer = button.nextElementSibling;
        const icon = button.querySelector('.material-symbols-outlined');
        document.querySelectorAll('.faq-item button').forEach((btn) => {
          if (btn !== button) { btn.setAttribute('aria-expanded', 'false'); btn.nextElementSibling?.classList.add('hidden'); btn.querySelector('.material-symbols-outlined')?.classList.remove('rotate-180'); }
        });
        button.setAttribute('aria-expanded', (!isExpanded).toString());
        answer?.classList.toggle('hidden');
        icon?.classList.toggle('rotate-180');
      });
    });
  }

  document.addEventListener('astro:page-load', initWebPage);
  initWebPage();
</script>

<style>
  .faq-answer { transition: all 0.3s ease; }
  .faq-item button:focus-visible { outline: 2px solid var(--color-primary); outline-offset: -2px; border-radius: 12px; }
</style>