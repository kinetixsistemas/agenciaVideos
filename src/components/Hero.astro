/**
 * Hero.astro - Sección principal de bienvenida
 *
 * Componente de pantalla completa que muestra:
 * - Imagen de fondo 3D con overlay gradiente
 * - Título principal con tipografía display-xl
 * - Subtítulo descriptivo
 * - Botón CTA "INICIAR PROYECTO"
 *
 * Usa GSAP ScrollTrigger para:
 * - Efecto parallax en la imagen de fondo
 * - Desvanecimiento del contenido al hacer scroll
 * - Animación de entrada del contenido
 *
 * @component
 */

---

<!-- Sección hero con imagen de fondo y contenido centrado -->
<section
  class="relative min-h-[100dvh] flex items-center justify-center overflow-hidden"
  aria-label="Hero - Bienvenida principal"
>
  <!-- Imagen de fondo 3D con overlay gradiente -->
  <div class="absolute inset-0 z-0">
    <div
      class="w-full h-full bg-cover bg-center bg-no-repeat hero-bg-image"
      style="background-image: url('/images/hero-3d-render.png'); will-change: transform;"
      aria-hidden="true"
    ></div>
    <!-- Overlay gradiente para legibilidad del texto -->
    <div class="absolute inset-0 bg-gradient-to-b from-surface/40 via-surface/20 to-surface/90"></div>
    <div class="absolute inset-0 bg-gradient-to-t from-surface via-transparent to-transparent"></div>
  </div>

  <!-- Contenido principal centrado -->
  <div class="relative z-10 max-w-[1200px] mx-auto w-full text-center flex flex-col items-center gap-6 px-6 md:px-12 hero-content">
    <!-- Título principal con efecto de color dual -->
    <h1
      class="heading-xl text-4xl sm:text-5xl md:text-6xl lg:text-7xl xl:text-[80px] text-white max-w-4xl"
      style="text-shadow: 0 4px 30px rgba(0, 0, 0, 0.8);"
    >
      Visión en Movimiento.<br />
      <span class="text-[#32D74B]">Código en Precisión.</span>
    </h1>

    <!-- Subtítulo descriptivo -->
    <p
      class="body-lg text-lg md:text-xl text-white/90 max-w-2xl"
      style="text-shadow: 0 2px 15px rgba(0, 0, 0, 0.9);"
    >
      Producción cinematográfica de élite encuentra ingeniería digital brutalista.
    </p>

    <!-- Botón CTA principal -->
    <div class="mt-4">
      <a
        class="btn-primary text-lg px-10 py-5"
        href="/contact"
        role="button"
      >
        INICIAR PROYECTO
      </a>
    </div>
  </div>

  <!-- Indicador de scroll -->
  <div
    class="absolute bottom-8 left-1/2 -translate-x-1/2 z-10 flex flex-col items-center gap-2 opacity-70"
    aria-hidden="true"
  >
    <span class="label-md text-xs text-white/60 uppercase tracking-widest">Scroll</span>
    <div class="w-6 h-10 rounded-full border-2 border-white/30 flex justify-center pt-2">
      <div class="w-1 h-3 bg-white/60 rounded-full animate-bounce"></div>
    </div>
  </div>
</section>

<script>
  /**
   * Efecto parallax y desvanecimiento para el hero usando GSAP ScrollTrigger.
   * La imagen de fondo se mueve más lento que el scroll.
   * El contenido se desvanece al hacer scroll.
   */
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  function initHeroAnimations() {
    const heroSection = document.querySelector('[aria-label*="Hero"]') as HTMLElement;
    const heroBg = document.querySelector('.hero-bg-image') as HTMLElement;
    const heroContent = document.querySelector('.hero-content') as HTMLElement;

    if (!heroSection || !heroBg || !heroContent) return;

    // Verificar preferencia de reduced-motion
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (prefersReducedMotion) return;

    // Parallax en la imagen de fondo
    gsap.to(heroBg, {
      y: 200,
      scale: 1.1,
      ease: "none",
      scrollTrigger: {
        trigger: heroSection,
        start: "top top",
        end: "bottom top",
        scrub: true,
      },
    });

    // Desvanecimiento del contenido
    gsap.to(heroContent, {
      opacity: 0,
      y: 60,
      ease: "none",
      scrollTrigger: {
        trigger: heroSection,
        start: "top top",
        end: "60% top",
        scrub: true,
      },
    });

    // Animación de entrada del contenido (scopado al hero)
    const heroH1 = heroContent.querySelector("h1");
    const heroP = heroContent.querySelector("p");
    const heroBtn = heroContent.querySelector(".btn-primary");

    const tl = gsap.timeline({ delay: 0.3 });

    if (heroH1) {
      tl.from(heroH1, {
        y: 60,
        opacity: 0,
        duration: 1,
        ease: "power3.out",
      });
    }
    if (heroP) {
      tl.from(heroP, {
        y: 40,
        opacity: 0,
        duration: 0.8,
        ease: "power3.out",
      }, "-=0.6");
    }
    if (heroBtn) {
      tl.from(heroBtn, {
        y: 30,
        opacity: 0,
        scale: 0.9,
        duration: 0.6,
        ease: "back.out(1.7)",
      }, "-=0.4");
    }
  }

  document.addEventListener("astro:page-load", initHeroAnimations);
  initHeroAnimations();
</script>
