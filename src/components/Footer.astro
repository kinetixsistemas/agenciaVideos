---
/**
 * Footer.astro - Pie de página mejorado
 *
 * Componente que contiene:
 * - Logo de marca
 * - Enlaces de navegación organizados por categorías
 * - Redes sociales
 * - Información de contacto
 * - Copyright y crédito "Elaborado por Kinetix Sistemas"
 *
 * Usa fondo gris para mejor contraste y legibilidad.
 */

/** Enlaces organizados por categorías */
const footerSections = [
  {
    title: "Servicios",
    links: [
      { label: "Edición de Videos", href: "/video-editing" },
      { label: "Diseño Gráfico", href: "/graphic-design" },
      { label: "Desarrollo Web", href: "/web-development" },
      { label: "Paquetes", href: "/packages" }
    ]
  },
  {
    title: "Empresa",
    links: [
      { label: "Sobre Nosotros", href: "/about" },
      { label: "Portfolio", href: "/projects" },
      { label: "FAQ", href: "/faq" },
      { label: "Contacto", href: "/contact" }
    ]
  },
  {
    title: "Legal",
    links: [
      { label: "Política de Privacidad", href: "/privacidad" },
      { label: "Términos y Condiciones", href: "/terminos" }
    ]
  }
];

/** Redes sociales */
const socialLinks = [
  { label: "Instagram", href: "#", icon: "photo_camera" },
  { label: "LinkedIn", href: "#", icon: "public" },
  { label: "Twitter", href: "#", icon: "tag" },
  { label: "GitHub", href: "#", icon: "code" }
];
---

<!-- Footer con fondo gris -->
<footer class="bg-[#1a1a1c] w-full relative z-10 border-t border-outline-variant/10">
  <div class="flex flex-col gap-12 px-6 md:px-12 py-16 md:py-20 max-w-[1440px] mx-auto">
    <!-- Fila superior: Logo y redes sociales -->
    <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-8">
      <!-- Logo de marca -->
      <div class="flex flex-col gap-2">
        <a
          class="heading-md text-2xl md:text-3xl text-primary hover:scale-105 transition-transform duration-200"
          href="/"
          aria-label="Electric Apple - Volver al inicio"
        >
          Electric Apple
        </a>
        <p class="body-md text-sm text-text-muted">
          Visión en Movimiento. Ingeniería Digital.
        </p>
      </div>

      <!-- Redes sociales -->
      <div class="flex items-center gap-4">
        {socialLinks.map((social) => (
          <a
            class="w-10 h-10 rounded-full bg-surface-container-high flex items-center justify-center text-text-muted hover:bg-[#32D74B] hover:text-surface-container-lowest transition-all duration-300"
            href={social.href}
            aria-label={social.label}
            target="_blank"
            rel="noopener noreferrer"
          >
            <span class="material-symbols-outlined text-lg" style="font-variation-settings: 'FILL' 0;">{social.icon}</span>
          </a>
        ))}
      </div>
    </div>

    <!-- Contenido principal: Enlaces organizados -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-8">
      <!-- Columna de servicios -->
      <div>
        <h3 class="heading-md text-lg text-text-primary mb-4">{footerSections[0].title}</h3>
        <ul class="space-y-3">
          {footerSections[0].links.map((link) => (
            <li>
              <a
                class="body-md text-sm text-text-muted hover:text-[#32D74B] transition-colors"
                href={link.href}
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Columna de empresa -->
      <div>
        <h3 class="heading-md text-lg text-text-primary mb-4">{footerSections[1].title}</h3>
        <ul class="space-y-3">
          {footerSections[1].links.map((link) => (
            <li>
              <a
                class="body-md text-sm text-text-muted hover:text-[#32D74B] transition-colors"
                href={link.href}
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Columna de legal -->
      <div>
        <h3 class="heading-md text-lg text-text-primary mb-4">{footerSections[2].title}</h3>
        <ul class="space-y-3">
          {footerSections[2].links.map((link) => (
            <li>
              <a
                class="body-md text-sm text-text-muted hover:text-[#32D74B] transition-colors"
                href={link.href}
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Columna de contacto -->
      <div>
        <h3 class="heading-md text-lg text-text-primary mb-4">Contacto</h3>
        <ul class="space-y-3">
          <li>
            <a
              class="body-md text-sm text-text-muted hover:text-[#32D74B] transition-colors flex items-center gap-2"
              href="mailto:hola@electricapple.agency"
            >
              <span class="material-symbols-outlined text-sm" style="font-variation-settings: 'FILL' 0;">mail</span>
              hola@electricapple.agency
            </a>
          </li>
          <li>
            <a
              class="body-md text-sm text-text-muted hover:text-[#32D74B] transition-colors flex items-center gap-2"
              href="tel:+13105551234"
            >
              <span class="material-symbols-outlined text-sm" style="font-variation-settings: 'FILL' 0;">phone</span>
              +1 (310) 555-1234
            </a>
          </li>
          <li>
            <span class="body-md text-sm text-text-muted flex items-center gap-2">
              <span class="material-symbols-outlined text-sm" style="font-variation-settings: 'FILL' 0;">location_on</span>
              Los Ángeles, CA
            </span>
          </li>
        </ul>
      </div>
    </div>

    <!-- Separador horizontal -->
    <div class="w-full h-px bg-outline-variant/20" role="separator"></div>

    <!-- Fila inferior: Copyright y crédito -->
    <div class="flex flex-col md:flex-row justify-between items-center gap-4 text-sm text-text-muted">
      <p class="body-md text-sm">
        &copy; {new Date().getFullYear()} Electric Apple. Todos los derechos reservados.
      </p>
      <p class="body-md text-sm flex items-center gap-2">
        Elaborado por 
        <span class="text-[#32D74B] font-semibold">Kinetix Sistemas</span>
        <span class="material-symbols-outlined text-[#32D74B] text-sm" style="font-variation-settings: 'FILL' 0;">bolt</span>
      </p>
    </div>
  </div>
</footer>