---
/**
 * Footer.astro - Pie de página mejorado
 *
 * Fondo gris, touch targets 44px+, responsive mobile-first.
 */
const footerSections = [
  {
    title: "Servicios",
    links: [
      { label: "Edición de Videos", href: "/video-editing" },
      { label: "Diseño Gráfico", href: "/graphic-design" },
      { label: "Desarrollo Web", href: "/web-development" },
      { label: "Paquetes", href: "/packages" }
    ]
  },
  {
    title: "Empresa",
    links: [
      { label: "Sobre Nosotros", href: "/about" },
      { label: "Portfolio", href: "/projects" },
      { label: "FAQ", href: "/faq" },
      { label: "Contacto", href: "/contact" }
    ]
  },
  {
    title: "Legal",
    links: [
      { label: "Privacidad", href: "/privacidad" },
      { label: "Términos", href: "/terminos" }
    ]
  }
];

const socialLinks = [
  { label: "Instagram", href: "#", icon: "photo_camera" },
  { label: "LinkedIn", href: "#", icon: "public" },
  { label: "Twitter", href: "#", icon: "tag" },
  { label: "GitHub", href: "#", icon: "code" }
];
---

<footer class="bg-[#1a1a1c] w-full relative z-10 border-t border-outline-variant/10">
  <div class="flex flex-col gap-10 px-5 md:px-12 py-12 md:py-20 max-w-[1440px] mx-auto">
    <!-- Top: Logo + Social -->
    <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-6">
      <div class="flex flex-col gap-1">
        <a
          class="flex items-center gap-2.5 hover:scale-105 transition-transform duration-200 min-h-[44px]"
          href="/"
          aria-label="Daller - Volver al inicio"
        >
          <img src="/images/dallerLogo.jpeg" alt="" class="h-9 md:h-10 w-9 md:w-10 rounded-full object-cover" />
          <span class="heading-md text-xl md:text-2xl font-bold text-primary">Daller</span>
        </a>
        <p class="body-md text-xs md:text-sm text-text-muted ml-[46px]">
          Visión en Movimiento. Ingeniería Digital.
        </p>
      </div>

      <div class="flex items-center gap-3">
        {socialLinks.map((social) => (
          <a
            class="w-11 h-11 rounded-full bg-surface-container-high flex items-center justify-center text-text-muted hover:bg-[#32D74B] hover:text-surface-container-lowest transition-all duration-300"
            href={social.href}
            aria-label={social.label}
            target="_blank"
            rel="noopener noreferrer"
          >
            <span class="material-symbols-outlined text-lg" style="font-variation-settings: 'FILL' 0;">{social.icon}</span>
          </a>
        ))}
      </div>
    </div>

    <!-- Links grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-8 md:gap-8">
      {footerSections.map((section) => (
        <div>
          <h3 class="heading-md text-base md:text-lg text-text-primary mb-3">{section.title}</h3>
          <ul class="flex flex-col gap-0.5">
            {section.links.map((link) => (
              <li>
                <a
                  class="body-md text-sm text-text-muted hover:text-[#32D74B] transition-colors inline-flex items-center min-h-[40px] py-1"
                  href={link.href}
                >
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}

      <!-- Contacto -->
      <div>
        <h3 class="heading-md text-base md:text-lg text-text-primary mb-3">Contacto</h3>
        <ul class="flex flex-col gap-0.5">
          <li>
            <a
              class="body-md text-sm text-text-muted hover:text-[#32D74B] transition-colors flex items-center gap-2 min-h-[40px] py-1"
              href="mailto:hola@daller.agency"
            >
              <span class="material-symbols-outlined text-sm" style="font-variation-settings: 'FILL' 0;">mail</span>
              hola@daller.agency
            </a>
          </li>
          <li>
            <a
              class="body-md text-sm text-text-muted hover:text-[#32D74B] transition-colors flex items-center gap-2 min-h-[40px] py-1"
              href="tel:+13105551234"
            >
              <span class="material-symbols-outlined text-sm" style="font-variation-settings: 'FILL' 0;">phone</span>
              +1 (310) 555-1234
            </a>
          </li>
          <li>
            <span class="body-md text-sm text-text-muted flex items-center gap-2 min-h-[40px] py-1">
              <span class="material-symbols-outlined text-sm" style="font-variation-settings: 'FILL' 0;">location_on</span>
              Los Ángeles, CA
            </span>
          </li>
        </ul>
      </div>
    </div>

    <!-- Separator -->
    <div class="w-full h-px bg-outline-variant/20" role="separator"></div>

    <!-- Bottom -->
    <div class="flex flex-col sm:flex-row justify-between items-center gap-3 text-xs md:text-sm text-text-muted">
      <p class="body-md">
        &copy; {new Date().getFullYear()} Daller. Todos los derechos reservados.
      </p>
      <p class="body-md flex items-center gap-1.5">
        Elaborado por
        <a href="https://kinetixsistemas.com" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 text-[#32D74B] font-semibold hover:underline">
          <img src="/images/og-kinetix.jpg" alt="" class="w-5 h-5 rounded-sm object-cover" aria-hidden="true" />
          Kinetix Sistemas
        </a>
      </p>
    </div>
  </div>
</footer>
