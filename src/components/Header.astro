---
/**
 * Header.astro - Barra de navegación con menú mobile mejorado
 *
 * - Logo de marca "Daller"
 * - Enlaces de navegación desktop
 * - Botón CTA "Iniciar Proyecto"
 * - Panel lateral slide-in para móvil con touch targets 44px+
 * - Soporte accesibilidad completo
 */
import { mainNav } from "../data/navigation";
---

<!-- Barra de navegación fija -->
<header
  class="fixed top-0 w-full z-50 bg-surface/80 backdrop-blur-xl border-b border-outline-variant/10"
  role="banner"
>
  <div
    class="flex justify-between items-center px-5 md:px-12 py-3 md:py-5 max-w-[1440px] mx-auto"
  >
    <!-- Logo -->
    <a
      class="flex items-center gap-2.5 min-h-[44px] hover:scale-105 transition-transform duration-200"
      href="/"
      aria-label="Daller - Volver al inicio"
    >
      <img
        src="/images/dallerLogo.jpeg"
        alt="Daller"
        class="h-9 md:h-10 w-9 md:w-10 rounded-full object-cover"
      />
      <span class="heading-md text-lg md:text-xl font-bold text-primary"
        >Daller Industries</span
      >
    </a>

    <!-- Desktop nav -->
    <nav
      class="hidden md:flex items-center gap-8"
      aria-label="Navegación principal"
    >
      {
        mainNav.map((item) => (
          <a
            class={`label-md text-sm transition-all duration-200 hover:text-primary hover:scale-105 ${
              Astro.url.pathname === item.href ||
              (item.href !== "/" && Astro.url.pathname.startsWith(item.href))
                ? "text-primary font-bold border-b-2 border-primary pb-1"
                : "text-on-surface-variant"
            }`}
            href={item.href}
            aria-current={Astro.url.pathname === item.href ? "page" : undefined}
          >
            {item.label}
          </a>
        ))
      }

      <!-- CTA desktop -->
      <a
        class="hidden md:inline-flex btn-primary text-sm px-6 py-3"
        href="/contact"
      >
        Iniciar Proyecto
      </a>
    </nav>

    <!-- Mobile hamburger -->
    <button
      id="mobile-menu-button"
      class="md:hidden text-primary min-h-[44px] min-w-[44px] flex items-center justify-center -mr-2"
      aria-label="Abrir menú de navegación"
      aria-expanded="false"
      aria-controls="mobile-menu-panel"
    >
      <span
        class="material-symbols-outlined text-[28px]"
        style="font-variation-settings: 'FILL' 0;">menu</span
      >
    </button>
  </div>
</header>

<!-- Backdrop -->
<div
  id="mobile-menu-backdrop"
  class="fixed inset-0 z-[60] bg-black/60 backdrop-blur-sm hidden"
  aria-hidden="true"
>
</div>

<!-- Panel lateral mobile -->
<aside
  id="mobile-menu-panel"
  class="fixed top-0 right-0 z-[70] h-full w-[min(320px,85vw)] bg-surface-container-low flex flex-col translate-x-full transition-[translate] duration-300 ease-out md:hidden"
  role="dialog"
  aria-modal="true"
  aria-label="Navegación móvil"
>
  <!-- Header del panel -->
  <div
    class="flex items-center justify-between px-5 py-4 border-b border-outline-variant/10"
  >
    <span class="heading-md text-base font-bold text-primary">Menú</span>
    <button
      id="mobile-menu-close"
      class="text-on-surface-variant hover:text-primary min-h-[44px] min-w-[44px] flex items-center justify-center -mr-2"
      aria-label="Cerrar menú"
    >
      <span
        class="material-symbols-outlined text-[24px]"
        style="font-variation-settings: 'FILL' 0;">close</span
      >
    </button>
  </div>

  <!-- Links -->
  <nav class="flex-1 overflow-y-auto py-4 px-5" aria-label="Menú móvil">
    <ul class="flex flex-col gap-1">
      {
        mainNav.map((item) => (
          <li>
            <a
              class={`flex items-center gap-3 px-4 py-3.5 rounded-2xl min-h-[48px] label-md text-base transition-colors ${
                Astro.url.pathname === item.href ||
                (item.href !== "/" && Astro.url.pathname.startsWith(item.href))
                  ? "bg-primary/10 text-primary font-semibold"
                  : "text-on-surface-variant hover:bg-surface-container-high/50 hover:text-primary"
              }`}
              href={item.href}
              aria-current={
                Astro.url.pathname === item.href ? "page" : undefined
              }
            >
              {item.label}
              {Astro.url.pathname === item.href && (
                <span
                  class="ml-auto w-1.5 h-1.5 rounded-full bg-primary"
                  aria-hidden="true"
                />
              )}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</aside>

<script>
  function initMobileMenu() {
    const openBtn = document.getElementById("mobile-menu-button");
    const closeBtn = document.getElementById("mobile-menu-close");
    const panel = document.getElementById("mobile-menu-panel");
    const backdrop = document.getElementById("mobile-menu-backdrop");
    if (!openBtn || !closeBtn || !panel || !backdrop) return;

    const openMenu = () => {
      panel.style.translate = "0";
      backdrop.classList.remove("hidden");
      openBtn.setAttribute("aria-expanded", "true");
      document.body.style.overflow = "hidden";
      closeBtn.focus();
    };

    const closeMenu = () => {
      panel.style.translate = "";
      backdrop.classList.add("hidden");
      openBtn.setAttribute("aria-expanded", "false");
      document.body.style.overflow = "";
      openBtn.focus();
    };

    openBtn.addEventListener("click", openMenu);
    closeBtn.addEventListener("click", closeMenu);
    backdrop.addEventListener("click", closeMenu);

    panel.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", closeMenu);
    });

    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && panel.style.translate === "0") {
        closeMenu();
      }
    });
  }

  document.addEventListener("astro:page-load", initMobileMenu);
  initMobileMenu();
</script>
