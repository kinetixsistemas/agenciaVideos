---
/**
 * Header.astro - Barra de navegación mejorada
 *
 * Componente fijo en la parte superior que contiene:
 * - Logo de marca "Electric Apple"
 * - Enlaces de navegación desktop y móvil
 * - Botón CTA "Iniciar Proyecto"
 * - Menú overlay para dispositivos móviles
 *
 * Incluye lógica JavaScript para toggle del menú móvil
 * con soporte para accesibilidad (aria-expanded, aria-controls).
 *
 * @component
 */
import { mainNav } from "../data/navigation";
---

<!-- Barra de navegación fija con efecto glassmorphism -->
<header
  class="fixed top-0 w-full z-50 bg-surface/80 backdrop-blur-xl border-b border-outline-variant/10"
  role="banner"
>
  <div class="flex justify-between items-center px-6 md:px-12 py-4 md:py-6 max-w-[1440px] mx-auto">
    <!-- Logo de marca -->
    <a
      class="heading-md text-lg md:text-xl font-bold text-primary hover:scale-105 transition-transform duration-200"
      href="/"
      aria-label="Electric Apple - Volver al inicio"
    >
      Electric Apple
    </a>

    <!-- Enlaces de navegación (solo desktop) -->
    <nav class="hidden md:flex items-center gap-8" aria-label="Navegación principal">
      {mainNav.map((item) => (
        <a
          class={`label-md text-sm transition-colors hover:text-primary hover:scale-105 transition-transform duration-200 ${
            Astro.url.pathname === item.href || (item.href !== "/" && Astro.url.pathname.startsWith(item.href))
              ? "text-primary font-bold border-b-2 border-primary pb-1"
              : "text-on-surface-variant"
          }`}
          href={item.href}
          aria-current={Astro.url.pathname === item.href ? "page" : undefined}
        >
          {item.label}
        </a>
      ))}
    </nav>

    <!-- Botón CTA principal -->
    <a
      class="hidden md:inline-flex btn-primary text-sm px-6 py-3"
      href="/contact"
    >
      Iniciar Proyecto
    </a>

    <!-- Botón de menú móvil -->
    <button
      id="mobile-menu-button"
      class="md:hidden text-primary p-2 -mr-2"
      aria-label="Abrir menú de navegación"
      aria-expanded="false"
      aria-controls="mobile-menu-overlay"
    >
      <span class="material-symbols-outlined" style="font-variation-settings: 'FILL' 0;">menu</span>
    </button>
  </div>
</header>

<!-- Overlay del menú móvil -->
<div
  id="mobile-menu-overlay"
  class="fixed inset-0 z-40 bg-surface-container-lowest/95 backdrop-blur-xl hidden flex-col justify-center items-center gap-8"
  role="dialog"
  aria-modal="true"
  aria-label="Navegación móvil"
>
  <nav class="flex flex-col items-center gap-6" aria-label="Menú móvil">
    {mainNav.map((item) => (
      <a
        class={`heading-md text-2xl transition-colors hover:text-primary ${
          Astro.url.pathname === item.href || (item.href !== "/" && Astro.url.pathname.startsWith(item.href))
            ? "text-primary"
            : "text-on-surface-variant"
        }`}
        href={item.href}
        aria-current={Astro.url.pathname === item.href ? "page" : undefined}
      >
        {item.label}
      </a>
    ))}
    <a
      class="mt-4 btn-primary text-base px-8 py-4"
      href="/contact"
    >
      Iniciar Proyecto
    </a>
  </nav>
</div>

<script>
  /**
   * Inicializa el menú móvil con toggle de apertura/cierre.
   * Maneja el estado de aria-expanded y bloquea el scroll
   * del body cuando el menú está abierto.
   */
  function initMobileMenu() {
    const button = document.getElementById("mobile-menu-button");
    const menu = document.getElementById("mobile-menu-overlay");
    if (!button || !menu) return;

    const closeMenu = () => {
      menu.classList.add("hidden");
      menu.classList.remove("flex");
      button.setAttribute("aria-expanded", "false");
      button.querySelector("span")!.textContent = "menu";
      document.body.style.overflow = "";
    };

    const openMenu = () => {
      menu.classList.remove("hidden");
      menu.classList.add("flex");
      button.setAttribute("aria-expanded", "true");
      button.querySelector("span")!.textContent = "close";
      document.body.style.overflow = "hidden";
    };

    // Toggle del menú al hacer clic en el botón
    button.addEventListener("click", () => {
      const isOpen = menu.classList.contains("flex");
      if (isOpen) {
        closeMenu();
      } else {
        openMenu();
      }
    });

    // Cerrar menú al hacer clic en cualquier enlace
    menu.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", closeMenu);
    });

    // Cerrar menú con tecla Escape
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && menu.classList.contains("flex")) {
        closeMenu();
        button.focus();
      }
    });
  }

  // Inicializar en carga de página y en transiciones de Astro
  document.addEventListener("astro:page-load", initMobileMenu);
  initMobileMenu();
</script>