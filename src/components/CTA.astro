---
/**
 * CTA.astro - Sección de llamada a la acción final
 *
 * Componente de cierre del home con:
 * - Título impactante con texto dual de color
 * - Subtítulo motivacional
 * - Botón CTA grande y destacado
 *
 * Usa fondo surface-container-highest para crear
 * contraste visual con el resto del contenido.
 *
 * @component
 */

---

<!-- Sección CTA con fondo diferenciado -->
<section
  class="py-24 md:py-32 px-6 md:px-12 bg-surface-container-highest"
  aria-labelledby="cta-heading"
>
  <div class="max-w-[1024px] mx-auto text-center flex flex-col items-center gap-6 md:gap-8">
    <!-- Título con efecto de color dual -->
    <h2
      id="cta-heading"
      class="heading-lg text-3xl md:text-5xl lg:text-6xl xl:text-[80px] leading-tight text-text-primary"
    >
      ¿Listo para construir lo<br />
      <span class="text-[#B535F6]">imposible?</span>
    </h2>

    <!-- Subtítulo descriptivo -->
    <p class="body-lg text-lg md:text-xl text-on-surface-variant max-w-2xl">
      Asociado con Electric Apple para llevar tus conceptos técnicos y visuales más ambiciosos a la vida. No hacemos promedios.
    </p>

    <!-- Botón CTA grande con efecto glow -->
    <a
      class="mt-4 md:mt-8 btn-primary text-lg md:text-xl px-10 md:px-14 py-5 md:py-6 rounded-3xl"
      href="/contact"
      role="button"
    >
      INICIAR PROYECTO AHORA
    </a>
  </div>
</section>

<script>
  /**
   * Animación de entrada para la sección CTA usando GSAP ScrollTrigger.
   */
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  function initCTAAnimations() {
    const section = document.querySelector('[aria-labelledby="cta-heading"]');
    if (!section) return;

    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (prefersReducedMotion) return;

    const heading = section.querySelector('#cta-heading');
    const description = section.querySelector('p');
    const button = section.querySelector('.btn-primary');

    const tl = gsap.timeline({
      scrollTrigger: {
        trigger: section,
        start: "top 75%",
        toggleActions: "play none none none",
      },
    });

    if (heading) {
      tl.from(heading, {
        y: 50,
        opacity: 0,
        duration: 0.8,
        ease: "power3.out",
      });
    }

    if (description) {
      tl.from(description, {
        y: 30,
        opacity: 0,
        duration: 0.6,
        ease: "power3.out",
      }, "-=0.4");
    }

    if (button) {
      tl.from(button, {
        y: 20,
        opacity: 0,
        scale: 0.9,
        duration: 0.5,
        ease: "back.out(1.7)",
      }, "-=0.3");
    }
  }

  document.addEventListener("astro:page-load", initCTAAnimations);
  initCTAAnimations();
</script>
