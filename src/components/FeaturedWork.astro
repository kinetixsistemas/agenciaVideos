---
/**
 * FeaturedWork.astro - Carrusel de proyectos destacados
 *
 * Muestra un carrusel infinito de proyectos con:
 * - Gradientes de borde para efecto de desvanecimiento
 * - Hover overlay con botón CTA
 * - Animación CSS scroll-carousel infinita
 * - Pausa de animación al hover
 *
 * Los proyectos se duplican para crear el efecto
 * de scroll infinito continuo.
 *
 * @component
 */
import { projects } from "../data/projects";
---

<!-- Sección de proyectos destacados con carrusel -->
<section
  class="py-24 md:py-32 overflow-hidden bg-surface"
  aria-labelledby="featured-work-heading"
>
  <!-- Cabecera con título y enlace "Ver todos" -->
  <div class="max-w-[1440px] mx-auto px-6 md:px-12 mb-12 md:mb-16 flex flex-col md:flex-row justify-between items-start md:items-end gap-6">
    <div>
      <span class="label-md text-sm text-[#32D74B] uppercase tracking-widest mb-4 block">Portafolio</span>
      <h2 id="featured-work-heading" class="heading-lg text-3xl md:text-4xl lg:text-5xl text-text-primary mb-4">
        Proyectos Destacados
      </h2>
      <p class="body-md text-base md:text-lg text-on-surface-variant max-w-lg">
        Una selección de nuestros proyectos más agresivos y de alta fidelidad en ingeniería digital y producción cinematográfica.
      </p>
    </div>
    <!-- Enlace a página de proyectos (solo desktop) -->
    <a
      class="hidden md:inline-flex items-center gap-2 text-primary hover:text-[#32D74B] transition-colors label-md text-sm group"
      href="/projects"
    >
      Ver Todos los Proyectos
      <span class="material-symbols-outlined transform group-hover:translate-x-1 transition-transform" style="font-variation-settings: 'FILL' 0;">arrow_forward</span>
    </a>
  </div>

  <!-- Contenedor del carrusel -->
  <div class="relative w-full overflow-hidden" role="region" aria-label="Carrusel de proyectos destacados">
    <!-- Gradientes de desvanecimiento en los bordes -->
    <div class="absolute left-0 top-0 bottom-0 w-16 md:w-32 bg-gradient-to-r from-surface to-transparent z-10 pointer-events-none" aria-hidden="true"></div>
    <div class="absolute right-0 top-0 bottom-0 w-16 md:w-32 bg-gradient-to-l from-surface to-transparent z-10 pointer-events-none" aria-hidden="true"></div>

    <!-- Pista del carrusel con items duplicados para scroll infinito -->
    <div class="carousel-track gap-6 md:gap-8 px-6 md:px-8">
      {[...projects, ...projects].map((project) => (
        <article class="w-[300px] md:w-[380px] flex-shrink-0 group cursor-pointer">
          <!-- Tarjeta de proyecto con imagen y hover overlay -->
          <div class="relative w-full h-[400px] md:h-[480px] rounded-3xl overflow-hidden glass-panel mb-4 md:mb-6">
            <div
              class="absolute inset-0 bg-cover bg-center transition-transform duration-700 group-hover:scale-110"
              style={`background-image: url('${project.image}')`}
              role="img"
              aria-label={`Proyecto: ${project.title}`}
            ></div>
            <!-- Overlay que aparece al hover con botón CTA -->
            <div class="absolute inset-0 bg-gradient-to-t from-surface/90 via-surface/20 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-end p-6 md:p-8">
              <span class="w-full py-3 md:py-4 rounded-full bg-[#32D74B] text-surface-container-lowest label-md text-sm md:text-base text-center">
                {project.cta}
              </span>
            </div>
          </div>
          <!-- Información del proyecto -->
          <h3 class="heading-md text-xl md:text-2xl text-text-primary font-bold">{project.title}</h3>
          <p class="body-md text-sm text-primary mt-1 md:mt-2">{project.tag}</p>
        </article>
      ))}
    </div>
  </div>

  <!-- Enlace móvil a página de proyectos -->
  <div class="mt-8 md:hidden text-center px-6">
    <a
      class="inline-flex items-center gap-2 text-primary hover:text-[#32D74B] transition-colors label-md text-sm"
      href="/projects"
    >
      Ver Todos los Proyectos
      <span class="material-symbols-outlined" style="font-variation-settings: 'FILL' 0;">arrow_forward</span>
    </a>
  </div>
</section>

<script>
  /**
   * Animación de entrada para la sección de proyectos destacados.
   */
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  function initFeaturedWorkAnimations() {
    const section = document.querySelector('[aria-labelledby="featured-work-heading"]');
    if (!section) return;

    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (prefersReducedMotion) return;

    // Animación de entrada del título
    const heading = section.querySelector('#featured-work-heading');
    if (heading) {
      gsap.from(heading, {
        y: 30,
        opacity: 0,
        duration: 0.8,
        ease: "power3.out",
        scrollTrigger: {
          trigger: section,
          start: "top 80%",
          toggleActions: "play none none none",
        },
      });
    }
  }

  document.addEventListener("astro:page-load", initFeaturedWorkAnimations);
  initFeaturedWorkAnimations();
</script>
